/* pages/auth/login/login.wxss */

/* ========== Keyframes ========== */
@keyframes cloud-drift {
  0% { transform: translateX(-100rpx); }
  100% { transform: translateX(750rpx); }
}

@keyframes anim-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

@keyframes anim-bounce-in {
  0% { opacity: 0; transform: scale(0.3) translateY(40rpx); }
  50% { opacity: 1; transform: scale(1.05) translateY(-8rpx); }
  70% { transform: scale(0.95) translateY(4rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes anim-twinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.3); }
}

@keyframes balloon-rise {
  0% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-60rpx) rotate(5deg); }
  50% { transform: translateY(-120rpx) rotate(-3deg); }
  75% { transform: translateY(-180rpx) rotate(4deg); }
  100% { transform: translateY(-240rpx) rotate(0deg); opacity: 0.4; }
}

@keyframes rainbow-shift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ========== Utility Animation Classes ========== */
.anim-float {
  animation: anim-float 3s ease-in-out infinite;
}

.anim-bounce-in {
  animation: anim-bounce-in 0.8s var(--ease-bounce) both;
}

.anim-twinkle {
  animation: anim-twinkle 2s ease-in-out infinite;
}

.tap-bounce {
  transition: transform 0.2s var(--ease-bounce);
}

.tap-bounce:active {
  transform: scale(0.95) !important;
}

/* ========== Page Layout ========== */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #87CEEB 0%, #B8E0F7 50%, var(--student-bg) 100%);
  position: relative;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-spacer {
  height: 88rpx;
}

/* ========== Sky Background & Clouds ========== */
.sky-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100vh;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 100rpx;
  animation: cloud-drift linear infinite;
}

.cloud::before {
  content: '';
  position: absolute;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 50%;
}

.cloud-1 {
  width: 240rpx;
  height: 80rpx;
  top: 120rpx;
  left: -240rpx;
  animation-duration: 25s;
}

.cloud-1::before {
  width: 100rpx;
  height: 100rpx;
  top: -50rpx;
  left: 60rpx;
}

.cloud-2 {
  width: 180rpx;
  height: 60rpx;
  top: 220rpx;
  left: -180rpx;
  animation-duration: 35s;
  animation-delay: 5s;
}

.cloud-2::before {
  width: 80rpx;
  height: 80rpx;
  top: -40rpx;
  left: 40rpx;
}

.cloud-3 {
  width: 280rpx;
  height: 90rpx;
  top: 80rpx;
  left: -280rpx;
  animation-duration: 30s;
  animation-delay: 10s;
  opacity: 0.7;
}

.cloud-3::before {
  width: 120rpx;
  height: 120rpx;
  top: -60rpx;
  left: 80rpx;
}

.cloud-4 {
  width: 160rpx;
  height: 50rpx;
  top: 300rpx;
  left: -160rpx;
  animation-duration: 22s;
  animation-delay: 15s;
  opacity: 0.6;
}

.cloud-4::before {
  width: 70rpx;
  height: 70rpx;
  top: -35rpx;
  left: 35rpx;
}

/* ========== Stars Layer ========== */
.stars-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  pointer-events: none;
  z-index: 1;
}

.star {
  position: absolute;
  color: var(--student-yellow);
  font-size: 28rpx;
}

.star-1 { top: 100rpx; left: 12%; animation-delay: 0s; }
.star-2 { top: 160rpx; right: 15%; animation-delay: 0.6s; }
.star-3 { top: 80rpx; right: 30%; animation-delay: 1.2s; font-size: 20rpx; }
.star-4 { top: 200rpx; left: 25%; animation-delay: 0.3s; font-size: 22rpx; }
.star-5 { top: 140rpx; left: 60%; animation-delay: 0.9s; font-size: 24rpx; }

/* ========== Balloons ========== */
.balloons-layer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100vh;
  pointer-events: none;
  z-index: 1;
}

.balloon {
  position: absolute;
  font-size: 56rpx;
  animation: balloon-rise 8s ease-in-out infinite;
}

.balloon-1 {
  bottom: 5%;
  left: 8%;
  animation-duration: 10s;
  animation-delay: 0s;
}

.balloon-2 {
  bottom: 10%;
  left: 50%;
  animation-duration: 12s;
  animation-delay: 3s;
}

.balloon-3 {
  bottom: 2%;
  right: 10%;
  animation-duration: 9s;
  animation-delay: 6s;
}

/* ========== Logo Section ========== */
.logo-section {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  padding-top: 40rpx;
  padding-bottom: 16rpx;
}

.logo-wrapper {
  position: relative;
  display: inline-flex;
}

.logo-icon {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, var(--student-yellow) 0%, #FFA500 100%);
  border-radius: var(--radius-child);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 165, 0, 0.45);
}

.icon-abc {
  font-size: 60rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.15);
}

.ai-badge {
  position: absolute;
  top: -16rpx;
  right: -24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FF6B6B, #FFD93D, #6BCB77, #5BC0EB, #C084FC, #FF8FAB);
  background-size: 300% 300%;
  animation: rainbow-shift 4s ease infinite, anim-float 2.5s ease-in-out infinite;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(192, 132, 252, 0.5);
}

.ai-badge-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

/* ========== App Name ========== */
.app-name-section {
  position: relative;
  z-index: 2;
  text-align: center;
  padding-bottom: 40rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 4rpx;
}

.app-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

/* ========== Role Selection ========== */
.role-section {
  position: relative;
  z-index: 2;
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.role-title {
  text-align: center;
  font-size: var(--font-child-md);
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.role-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.role-card {
  min-height: var(--touch-min);
  border-radius: var(--radius-child);
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
}

.role-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: var(--radius-child);
  border: 4rpx solid transparent;
  pointer-events: none;
  transition: border-color 0.3s ease;
}

.role-card.active::after {
  border-color: #FFFFFF;
}

.role-card.active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* Role-specific gradients */
.role-student {
  background: linear-gradient(145deg, #5BC0EB 0%, #87CEEB 100%);
}

.role-parent {
  background: linear-gradient(145deg, #FF8FAB 0%, #FFB6C8 100%);
}

.role-teacher {
  background: linear-gradient(145deg, #6BCB77 0%, #8ED99A 100%);
}

.role-principal {
  background: linear-gradient(145deg, #C084FC 0%, #D4A5FD 100%);
}

.role-emoji {
  font-size: 64rpx;
  margin-bottom: 12rpx;
  line-height: 1.2;
}

.role-name {
  font-size: var(--font-child-md);
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.15);
}

/* ========== Login Actions ========== */
.login-actions {
  position: relative;
  z-index: 2;
  padding: 0 48rpx;
  margin-bottom: 32rpx;
}

.btn-wechat {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 50rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.35);
  border: none;
  padding: 0;
  margin: 0;
  line-height: 100rpx;
}

.btn-wechat::after {
  border: none;
}

.btn-wechat-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon-circle {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.wechat-icon-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.btn-wechat-text {
  font-size: var(--font-child-md);
  font-weight: 700;
  color: #FFFFFF;
}

/* Phone login link */
.phone-login-link {
  text-align: center;
  padding: 24rpx 0;
  min-height: var(--touch-min);
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-link-text {
  font-size: 28rpx;
  color: rgba(91, 192, 235, 0.9);
  font-weight: 500;
}

/* Phone login form */
.phone-form {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s var(--ease-bounce), opacity 0.3s ease;
  opacity: 0;
  background: #FFFFFF;
  border-radius: var(--radius-child);
  padding: 0 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
}

.phone-form.show {
  max-height: 600rpx;
  opacity: 1;
  padding: 36rpx 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
}

.label-icon {
  margin-right: 10rpx;
  font-size: 30rpx;
}

.form-input {
  height: 88rpx;
  background: #F5F7FA;
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.form-input:focus {
  border-color: var(--student-sky);
  background: #FFFFFF;
}

.btn-phone-login {
  background: linear-gradient(135deg, var(--student-sky) 0%, #3AAFE0 100%);
  border-radius: 50rpx;
  height: var(--touch-min);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: var(--font-child-md);
  font-weight: 700;
  border: none;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 192, 235, 0.3);
}

.btn-phone-login::after {
  border: none;
}

/* ========== Footer ========== */
.footer-section {
  position: relative;
  z-index: 2;
  padding: 24rpx 32rpx 48rpx;
  text-align: center;
}

.agreement-text {
  font-size: 22rpx;
  color: rgba(100, 100, 100, 0.6);
  line-height: 1.8;
}

.link {
  color: var(--student-sky);
  font-weight: 500;
}
