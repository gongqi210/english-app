/* pages/auth/login/login.wxss */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90D9 0%, #6BA3E0 40%, #87CEEB 70%, #F8F9FA 100%);
  position: relative;
  overflow: hidden;
}

/* 顶部装饰 */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  overflow: hidden;
}

.cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50rpx;
}

.cloud-1 {
  width: 200rpx;
  height: 80rpx;
  top: 60rpx;
  left: -50rpx;
  animation: cloudMove 15s linear infinite;
}

.cloud-2 {
  width: 150rpx;
  height: 60rpx;
  top: 100rpx;
  right: -30rpx;
  animation: cloudMove 20s linear infinite;
}

.cloud-3 {
  width: 100rpx;
  height: 40rpx;
  top: 40rpx;
  left: 30%;
  animation: cloudMove 18s linear infinite;
}

@keyframes cloudMove {
  0% { transform: translateX(0); }
  100% { transform: translateX(200rpx); }
}

/* Logo区域 */
.logo-section {
  position: relative;
  padding-top: 180rpx;
  padding-bottom: 60rpx;
  text-align: center;
}

.logo-wrapper {
  position: relative;
  display: inline-block;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(255, 165, 0, 0.4);
}

.icon-abc {
  font-size: 48rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.logo-float {
  position: absolute;
  top: -20rpx;
  right: -30rpx;
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #FF69B4 0%, #FF1493 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 2s ease-in-out infinite;
}

.ai-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.app-name {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.app-slogan {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 角色选择 */
.role-selection {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.role-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.role-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.role-card {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.role-card.active {
  border-color: #4A90D9;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.2);
  transform: translateY(-4rpx);
}

.role-card:active {
  transform: scale(0.98);
}

.role-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.role-desc {
  font-size: 22rpx;
  color: #999999;
}

.role-card:nth-child(1) .role-icon { background: linear-gradient(135deg, #FFE066 0%, #FFB347 100%); }
.role-card:nth-child(2) .role-icon { background: linear-gradient(135deg, #87CEEB 0%, #4A90D9 100%); }
.role-card:nth-child(3) .role-icon { background: linear-gradient(135deg, #98FB98 0%, #32CD32 100%); }
.role-card:nth-child(4) .role-icon { background: linear-gradient(135deg, #DDA0DD 0%, #9370DB 100%); }

/* 登录表单 */
.form-section {
  background: #FFFFFF;
  margin: 0 32rpx;
  padding: 48rpx 40rpx;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 10;
}

.btn-wechat {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  margin-bottom: 40rpx;
}

.btn-wechat:active {
  transform: scale(0.98);
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon {
  width: 48rpx;
  height: 48rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #07C160;
  margin-right: 16rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.divider-line {
  display: flex;
  align-items: center;
  margin: 32rpx 0;
}

.divider-line::before,
.divider-line::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #EEEEEE;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #999999;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.label-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.form-input {
  height: 88rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.form-input:focus {
  border-color: #4A90D9;
  background: #FFFFFF;
}

.btn-login {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  border-radius: 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.3);
  margin-top: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-login:active {
  transform: scale(0.98);
}

/* 角色切换 */
.role-switch {
  margin-top: 40rpx;
}

.role-tabs {
  display: flex;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 6rpx;
}

.role-tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.role-tab.active {
  background: #FFFFFF;
  color: #4A90D9;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 底部说明 */
.footer-section {
  padding: 48rpx 32rpx;
  text-align: center;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.link {
  color: #FFD700;
}

/* 装饰动画 */
.decoration-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.star {
  position: absolute;
  font-size: 32rpx;
  animation: twinkle 2s ease-in-out infinite;
}

.star-1 {
  top: 20%;
  left: 15%;
  animation-delay: 0s;
}

.star-2 {
  top: 30%;
  right: 20%;
  animation-delay: 0.5s;
}

.star-3 {
  top: 15%;
  right: 10%;
  animation-delay: 1s;
}

.star-4 {
  top: 40%;
  left: 8%;
  animation-delay: 1.5s;
}

@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.2); }
}

.balloon {
  position: absolute;
  font-size: 48rpx;
  animation: balloonFloat 4s ease-in-out infinite;
}

.balloon-1 {
  bottom: 20%;
  left: 10%;
  animation-delay: 0s;
}

.balloon-2 {
  bottom: 30%;
  right: 5%;
  animation-delay: 2s;
}

@keyframes balloonFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(5deg); }
}
