/* pages/parent/purchase/purchase.wxss */
page {
  background: #F5F7FA;
}

.purchase-page {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 套餐选择 */
.package-section {
  margin-bottom: 32rpx;
}

.package-list {
  display: flex;
  flex-direction: column;
}

.package-item {
  background: #FFFFFF;
  border: 2rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.package-item.selected {
  border-color: #667EEA;
  background: rgba(102, 126, 234, 0.05);
}

.package-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.package-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.package-badge {
  background: #667EEA;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.package-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.price-value {
  font-size: 48rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: #999999;
  margin-left: 4rpx;
}

.package-original {
  font-size: 24rpx;
  color: #999999;
  text-decoration: line-through;
  margin-top: 8rpx;
}

/* 支付方式 */
.payment-section {
  margin-bottom: 32rpx;
}

.payment-methods {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.method-item:last-child {
  border-bottom: none;
}

.method-item.selected {
  background: rgba(102, 126, 234, 0.05);
}

.method-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.method-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #E5E5E5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: transparent;
}

.method-check.checked {
  background: #667EEA;
  border-color: #667EEA;
  color: #FFFFFF;
}

/* 底部支付 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.total-info {
  flex: 1;
}

.total-label {
  font-size: 26rpx;
  color: #666666;
}

.total-price {
  font-size: 36rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.btn-pay {
  width: 240rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 88rpx;
}

/* 支付弹窗 */
.pay-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  visibility: hidden;
}

.pay-modal.show {
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 36rpx;
  color: #999999;
}

.modal-body {
  padding: 48rpx 32rpx;
  text-align: center;
}

.pay-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}

.amount-symbol {
  font-size: 36rpx;
  color: #FF6B6B;
}

.amount-value {
  font-size: 72rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.pay-package {
  font-size: 26rpx;
  color: #666666;
}

.modal-footer {
  padding: 24rpx 32rpx 48rpx;
}

.btn-confirm-pay {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 88rpx;
}
