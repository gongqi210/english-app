<view class="purchase-page">
  <!-- Custom Navigation -->
  <view class="custom-nav">
    <view class="nav-content">
      <view class="nav-back" bindtap="onBack">
        <text>←</text>
      </view>
      <text class="nav-title">购买会员</text>
    </view>
  </view>

  <!-- Main Content -->
  <view class="main-content">
    <!-- Package Selection -->
    <view class="section-header">
      <text class="section-title">选择套餐</text>
    </view>
    <view class="package-list">
      <view
        class="package-item {{selectedPackage === item.id ? 'selected' : ''}}"
        wx:for="{{packages}}"
        wx:key="id"
        bindtap="onSelectPackage"
        data-id="{{item.id}}"
      >
        <view class="package-item-inner">
          <view class="package-header">
            <text class="package-name">{{item.name}}</text>
            <view class="package-badge" wx:if="{{item.popular}}">
              <text>推荐</text>
            </view>
          </view>
          <view class="package-price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item.price}}</text>
            <text class="price-unit">/{{item.unit}}</text>
          </view>
          <view class="package-original" wx:if="{{item.originalPrice}}">
            <text>原价 ¥{{item.originalPrice}}</text>
          </view>
          <view class="package-selected-check" wx:if="{{selectedPackage === item.id}}">
            <text>✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Payment Method -->
    <view class="section-header">
      <text class="section-title">支付方式</text>
    </view>
    <view class="payment-section">
      <view
        class="payment-method {{selectedPayment === 'wechat' ? 'selected' : ''}}"
        bindtap="onSelectPayment"
        data-method="wechat"
      >
        <view class="payment-icon">
          <text class="icon-wechat">💚</text>
        </view>
        <view class="payment-info">
          <text class="payment-name">微信支付</text>
          <text class="payment-desc">推荐</text>
        </view>
        <view class="payment-check {{selectedPayment === 'wechat' ? 'checked' : ''}}">
          <text class="check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Fixed Bottom Action Bar -->
  <view class="bottom-action">
    <view class="bottom-content">
      <view class="total-info">
        <text class="total-label">合计：</text>
        <text class="total-price">
          <text class="total-symbol">¥</text>
          <text class="total-value">{{currentPackage.price}}</text>
        </text>
      </view>
      <button class="btn-pay" bindtap="onPay" hover-class="tap-bounce">
        <text>立即支付</text>
      </button>
    </view>
  </view>

  <!-- Payment Confirmation Modal -->
  <view class="pay-modal {{showPayModal ? 'show' : ''}}" wx:if="{{showPayModal}}">
    <view class="modal-mask" bindtap="onCloseModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">确认支付</text>
        <view class="modal-close" bindtap="onCloseModal">
          <text>✕</text>
        </view>
      </view>
      <view class="modal-body">
        <view class="pay-amount">
          <text class="amount-symbol">¥</text>
          <text class="amount-value">{{currentPackage.price}}</text>
        </view>
        <view class="pay-package">{{currentPackage.name}}</view>
      </view>
      <view class="modal-footer">
        <button class="btn-confirm-pay" bindtap="onConfirmPay" hover-class="tap-bounce">
          确认支付
        </button>
      </view>
    </view>
  </view>
</view>
