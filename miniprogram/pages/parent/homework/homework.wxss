/* pages/parent/homework/homework.wxss */

/* Design System Variables */
page {
  --parent-primary: #FF8FAB;
  --parent-primary-dark: #FF5C8A;
  --parent-primary-light: #FFB5C8;
  --parent-bg: #FFF5F7;
  --bg-card: #FFFFFF;
  --radius-child: 40rpx;
  --radius-lg: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
}

page {
  background: var(--parent-bg);
  min-height: 100vh;
}

.homework-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* Custom Navigation */
.custom-nav {
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  padding: 60rpx 32rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  text-align: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
}

/* Main Content */
.main-content {
  padding: 24rpx 32rpx;
  margin-top: -20rpx;
}

/* Child Info Card */
.child-card {
  background: var(--bg-card);
  border-radius: var(--radius-child);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 140, 171, 0.15);
}

.child-card-inner {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.child-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid var(--parent-primary-light);
  margin-right: 24rpx;
}

.child-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.child-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.child-class {
  font-size: 26rpx;
  color: #666666;
}

.child-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.progress-ring-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.progress-label {
  font-size: 20rpx;
  color: #999999;
}

/* Progress Bar */
.progress-bar-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  border-radius: 8rpx;
  transition: width 0.4s var(--ease-smooth);
}

.progress-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--parent-primary-dark);
  min-width: 80rpx;
  text-align: right;
}

/* Section Header */
.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* Today's Homework Card */
.today-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 8rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 171, 0.12);
}

.today-card-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.today-info {
  flex: 1;
  margin-right: 24rpx;
}

.today-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.today-deadline {
  display: flex;
  align-items: center;
}

.deadline-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.deadline-text {
  font-size: 24rpx;
  color: var(--parent-primary-dark);
}

.btn-remind {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  border-radius: 40rpx;
  border: none;
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
  line-height: 1;
}

.btn-remind-icon {
  font-size: 24rpx;
}

.tap-bounce {
  transform: scale(0.95);
  opacity: 0.9;
}

/* Empty Today */
.empty-today {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
}

/* Completed List */
.completed-list {
  margin-bottom: 32rpx;
}

.completed-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: 16rpx;
  overflow: hidden;
}

.completed-card-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.completed-info {
  flex: 1;
}

.completed-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.completed-meta {
  display: flex;
  gap: 24rpx;
}

.completed-date,
.completed-time {
  font-size: 22rpx;
  color: #999999;
}

.completed-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--parent-primary-dark);
}

.score-unit {
  font-size: 22rpx;
  color: var(--parent-primary);
  margin-right: 12rpx;
}

.stars-container {
  display: flex;
  gap: 4rpx;
}

.stars {
  font-size: 22rpx;
  color: #FFD700;
}

/* Trend Card */
.trend-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.trend-chart {
  margin-bottom: 24rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 200rpx;
  padding: 0 16rpx;
}

.chart-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.chart-bar {
  width: 40rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  margin-bottom: 12rpx;
  transition: height 0.6s var(--ease-smooth);
}

.chart-bar-label {
  font-size: 20rpx;
  color: #999999;
}

.trend-summary {
  background: linear-gradient(135deg, rgba(255, 140, 171, 0.08) 0%, rgba(255, 92, 138, 0.05) 100%);
  border-radius: var(--radius-lg);
  padding: 20rpx;
}

.trend-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.trend-item:last-child {
  margin-bottom: 0;
}

.trend-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
}

.trend-label {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.trend-suggestion {
  font-size: 24rpx;
  color: #666666;
}
