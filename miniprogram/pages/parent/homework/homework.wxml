<view class="homework-page">
  <!-- Custom Navigation -->
  <view class="custom-nav">
    <view class="nav-content">
      <view class="nav-back" bindtap="onBack">
        <text>←</text>
      </view>
      <text class="nav-title">孩子作业</text>
    </view>
  </view>

  <!-- Main Content -->
  <view class="main-content">
    <!-- Child Info Card -->
    <view class="child-card">
      <view class="child-card-inner">
        <image class="child-avatar" src="{{currentChild.avatar}}" />
        <view class="child-info">
          <text class="child-name">{{currentChild.name}}</text>
          <text class="child-class">{{currentChild.className}}</text>
        </view>
        <view class="child-progress">
          <view class="progress-ring">
            <view class="progress-ring-text">{{weeklyStats.completed}}/{{weeklyStats.total}}</view>
          </view>
          <text class="progress-label">本周完成</text>
        </view>
      </view>
      <view class="progress-bar-container">
        <view class="progress-bar-bg">
          <view class="progress-bar-fill" style="width: {{weeklyStats.total > 0 ? (weeklyStats.completed / weeklyStats.total * 100) : 0}}%;"></view>
        </view>
        <text class="progress-text">{{weeklyStats.total > 0 ? Math.round(weeklyStats.completed / weeklyStats.total * 100) : 0}}%</text>
      </view>
    </view>

    <!-- Today's Homework Card -->
    <view class="section-header">
      <text class="section-title">今日待完成</text>
    </view>
    <view class="today-card" wx:if="{{todayHomework}}">
      <view class="today-card-inner">
        <view class="today-info">
          <text class="today-title">{{todayHomework.title}}</text>
          <view class="today-deadline">
            <text class="deadline-icon">⏰</text>
            <text class="deadline-text">截止：{{todayHomework.deadline}}</text>
          </view>
        </view>
        <button class="btn-remind" bindtap="onRemind" hover-class="tap-bounce">
          <text class="btn-remind-icon">🔔</text>
          <text>提醒孩子</text>
        </button>
      </view>
    </view>
    <view class="empty-today" wx:if="{{!todayHomework}}">
      <text class="empty-icon">🎉</text>
      <text class="empty-text">今日作业已全部完成！</text>
    </view>

    <!-- Completed Homework List -->
    <view class="section-header">
      <text class="section-title">最近完成</text>
    </view>
    <view class="completed-list">
      <view class="completed-card" wx:for="{{completedHomework}}" wx:key="id">
        <view class="completed-card-inner">
          <view class="completed-info">
            <text class="completed-title">{{item.title}}</text>
            <view class="completed-meta">
              <text class="completed-date">{{item.date}}</text>
              <text class="completed-time">用时：{{item.timeSpent}}</text>
            </view>
          </view>
          <view class="completed-score">
            <text class="score-value">{{item.score}}</text>
            <text class="score-unit">分</text>
            <view class="stars-container">
              <text class="stars">{{item.stars}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Learning Trend Chart -->
    <view class="section-header">
      <text class="section-title">学习趋势</text>
    </view>
    <view class="trend-card">
      <view class="trend-chart">
        <view class="chart-bars">
          <view class="chart-bar-item" wx:for="{{trendData}}" wx:key="index">
            <view class="chart-bar" style="height: {{item.value * 3}}rpx; background: {{item.color}};"></view>
            <text class="chart-bar-label">{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="trend-summary">
        <view class="trend-item">
          <text class="trend-icon">📊</text>
          <text class="trend-label">薄弱环节：听力理解</text>
        </view>
        <view class="trend-item">
          <text class="trend-icon">💡</text>
          <text class="trend-suggestion">建议加强练习</text>
        </view>
      </view>
    </view>
  </view>
</view>
