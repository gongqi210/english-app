/* pages/parent/orders/orders.wxss */

/* Design System Variables */
page {
  --parent-primary: #FF8FAB;
  --parent-primary-dark: #FF5C8A;
  --parent-primary-light: #FFB5C8;
  --parent-bg: #FFF5F7;
  --bg-card: #FFFFFF;
  --radius-child: 40rpx;
  --radius-lg: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
}

page {
  background: var(--parent-bg);
  height: 100vh;
}

.orders-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Custom Navigation */
.custom-nav {
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  padding: 60rpx 32rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  text-align: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
}

/* Main Content */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: -24rpx;
  overflow: hidden;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  margin: 0 32rpx;
  border-radius: var(--radius-lg);
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 171, 0.12);
}

.tab-item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 20rpx;
  transition: all 0.3s var(--ease-smooth);
}

.tab-item.active {
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
}

.tab-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #FFFFFF;
}

/* Order List */
.order-list {
  flex: 1;
  padding: 0 32rpx;
  padding-bottom: 32rpx;
}

/* Order Card */
.order-card {
  margin-bottom: 20rpx;
}

.order-card-inner {
  background: var(--bg-card);
  border-radius: var(--radius-child);
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 140, 171, 0.1);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.order-no {
  font-size: 22rpx;
  color: #999999;
}

.order-status-pill {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.order-status-pill.paid {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.12) 0%, rgba(82, 196, 26, 0.08) 100%);
}

.order-status-pill.paid .status-text {
  color: #52C41A;
}

.order-status-pill.pending {
  background: linear-gradient(135deg, rgba(255, 148, 6, 0.12) 0%, rgba(255, 148, 6, 0.08) 100%);
}

.order-status-pill.pending .status-text {
  color: #FA8C16;
}

.order-status-pill.refund {
  background: linear-gradient(135deg, rgba(153, 153, 153, 0.12) 0%, rgba(153, 153, 153, 0.08) 100%);
}

.order-status-pill.refund .status-text {
  color: #999999;
}

.status-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* Order Body */
.order-body {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-info {
  flex: 1;
}

.order-name {
  display: block;
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.order-desc {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.order-date {
  display: block;
  font-size: 22rpx;
  color: #CCCCCC;
}

.order-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: var(--parent-primary-dark);
}

.price-value {
  font-size: 40rpx;
  color: var(--parent-primary-dark);
  font-weight: bold;
}

/* Order Footer */
.order-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.btn-refund,
.btn-pay {
  font-size: 24rpx;
  padding: 14rpx 32rpx;
  border-radius: 24rpx;
  border: none;
  line-height: 1;
}

.btn-refund {
  background: var(--bg-card);
  border: 2rpx solid #E0E0E0;
  color: #666666;
}

.btn-pay {
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 171, 0.3);
}

.tap-bounce {
  transform: scale(0.96);
  opacity: 0.9;
}

/* Empty State */
.empty-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.btn-goshop {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 171, 0.35);
}
