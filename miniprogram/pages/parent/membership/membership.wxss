/* pages/parent/membership/membership.wxss */
page {
  background: #F5F7FA;
  padding-bottom: 140rpx;
}

.membership-page {
  padding: 24rpx;
}

/* 会员卡片 */
.member-card {
  position: relative;
  height: 400rpx;
  margin-bottom: 24rpx;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
}

.card-content {
  position: relative;
  padding: 40rpx;
  height: 100%;
  box-sizing: border-box;
}

.member-level {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.level-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  margin-right: 16rpx;
}

.level-badge.free { background: rgba(255,255,255,0.3); }
.level-badge.silver { background: linear-gradient(90deg, #C0C0C0, #E8E8E8); color: #666; }
.level-badge.gold { background: linear-gradient(90deg, #FFD700, #FFA500); }
.level-badge.diamond { background: linear-gradient(90deg, #00D4FF, #667EEA); }

.member-name {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.member-info {
  display: flex;
  margin-bottom: 32rpx;
}

.info-item {
  margin-right: 48rpx;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.member-benefits {
  display: flex;
  flex-wrap: wrap;
}

.benefit-item {
  display: flex;
  align-items: center;
  width: 50%;
  margin-bottom: 12rpx;
}

.benefit-item .benefit-icon {
  color: #52C41A;
  margin-right: 8rpx;
  font-size: 24rpx;
}

.benefit-item .benefit-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

/* 续费按钮 */
.renewal-section {
  margin-bottom: 24rpx;
}

.btn-renewal {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 88rpx;
}

/* 会员权益 */
.benefits-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.benefits-grid {
  display: flex;
  flex-wrap: wrap;
}

.benefit-card {
  width: 30%;
  text-align: center;
  padding: 20rpx 0;
  margin-right: 5%;
  margin-bottom: 20rpx;
}

.benefit-card:nth-child(3n) {
  margin-right: 0;
}

.benefit-card .benefit-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.benefit-card .benefit-name {
  display: block;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.benefit-card .benefit-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.benefit-card .benefit-status {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.benefit-status.active {
  background: rgba(82, 196, 26, 0.15);
  color: #52C41A;
}

.benefit-status.locked {
  background: #F5F5F5;
  color: #999999;
}

/* 套餐对比 */
.packages-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.packages-list {
  display: flex;
  flex-direction: column;
}

.package-card {
  position: relative;
  border: 2rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.package-card.popular {
  border-color: #667EEA;
  background: rgba(102, 126, 234, 0.05);
}

.popular-tag {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: #667EEA;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.package-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.package-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.price-value {
  font-size: 56rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
}

.package-original {
  font-size: 24rpx;
  color: #999999;
  text-decoration: line-through;
  margin-bottom: 16rpx;
}

.package-features {
  margin-bottom: 20rpx;
}

.package-features .feature {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.package-features .feature text {
  color: #52C41A;
  margin-right: 8rpx;
}

.btn-buy {
  width: 100%;
  height: 72rpx;
  background: #667EEA;
  border-radius: 36rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  border: none;
  line-height: 72rpx;
}

.package-card.popular .btn-buy {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.nav-item {
  flex: 1;
  text-align: center;
}

.nav-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.nav-text {
  font-size: 22rpx;
  color: #666666;
}
