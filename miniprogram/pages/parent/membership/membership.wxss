/* pages/parent/membership/membership.wxss */

/* Design System Variables */
page {
  --parent-primary: #FF8FAB;
  --parent-primary-dark: #FF5C8A;
  --parent-primary-light: #FFB5C8;
  --parent-bg: #FFF5F7;
  --bg-card: #FFFFFF;
  --radius-child: 40rpx;
  --radius-lg: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
}

page {
  background: var(--parent-bg);
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.membership-page {
  min-height: 100vh;
}

/* Custom Navigation */
.custom-nav {
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  padding: 60rpx 32rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  text-align: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
}

/* Main Content */
.main-content {
  padding: 24rpx 32rpx;
  margin-top: -24rpx;
}

/* Member Card */
.member-card {
  position: relative;
  border-radius: var(--radius-child);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(255, 140, 171, 0.25);
}

.member-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FF8FAB 0%, #FF5C8A 50%, #FFB5C8 100%);
}

.member-card-content {
  position: relative;
  padding: 40rpx 32rpx;
}

.member-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.level-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
}

.level-badge.free {
  background: rgba(255, 255, 255, 0.25);
}

.level-badge.silver {
  background: linear-gradient(90deg, #C0C0C0, #E8E8E8);
}

.level-badge.gold {
  background: linear-gradient(90deg, #FFD700, #FFA500);
}

.level-badge.diamond {
  background: linear-gradient(90deg, #00D4FF, #667EEA);
}

.level-icon {
  font-size: 24rpx;
}

.level-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.member-name {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.member-stats {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-lg);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.stat-value.highlight {
  color: #FFD700;
}

.stat-divider {
  width: 2rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.3);
}

.member-benefits {
  display: flex;
  flex-wrap: wrap;
}

.benefit-item {
  display: flex;
  align-items: center;
  width: 50%;
  margin-bottom: 12rpx;
}

.benefit-check {
  color: #FFD700;
  font-size: 24rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

.benefit-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
}

/* Renewal Button */
.btn-renewal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 165, 0, 0.35);
}

.btn-renewal-icon {
  font-size: 28rpx;
}

.tap-bounce {
  transform: scale(0.96);
  opacity: 0.9;
}

/* Benefits Section */
.benefits-section {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 171, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.benefits-grid {
  display: flex;
  flex-wrap: wrap;
}

.benefit-card {
  width: 30%;
  text-align: center;
  padding: 20rpx 0;
  margin-right: 5%;
  margin-bottom: 20rpx;
}

.benefit-card:nth-child(3n) {
  margin-right: 0;
}

.benefit-card .benefit-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.benefit-card .benefit-name {
  display: block;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.benefit-card .benefit-desc {
  display: block;
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 10rpx;
}

.benefit-status {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.benefit-card.unlocked .benefit-status {
  background: rgba(255, 140, 171, 0.15);
  color: var(--parent-primary-dark);
}

.benefit-card.locked .benefit-status {
  background: #F5F5F5;
  color: #999999;
}

/* Packages Section */
.packages-section {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 171, 0.1);
}

.packages-list {
  display: flex;
  flex-direction: column;
}

.package-card {
  position: relative;
  border: 2rpx solid #E8E8E8;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
}

.package-card.popular {
  border-color: #FFD700;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.05) 0%, rgba(255, 165, 0, 0.03) 100%);
}

.popular-tag {
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(90deg, #FFD700, #FFA500);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.package-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
  text-align: center;
}

.package-price {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 8rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: var(--parent-primary-dark);
  font-weight: bold;
}

.price-value {
  font-size: 56rpx;
  color: var(--parent-primary-dark);
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: #999999;
  margin-left: 4rpx;
}

.package-original {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  text-decoration: line-through;
  margin-bottom: 16rpx;
}

.package-features {
  margin-bottom: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.feature-check {
  color: var(--parent-primary);
  font-size: 24rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

.feature-text {
  font-size: 24rpx;
  color: #666666;
}

.btn-buy {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, var(--parent-primary) 0%, var(--parent-primary-dark) 100%);
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  line-height: 80rpx;
}

.package-card.popular .btn-buy {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
}

/* Bottom Navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: var(--bg-card);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.nav-text {
  font-size: 22rpx;
  color: #666666;
}
