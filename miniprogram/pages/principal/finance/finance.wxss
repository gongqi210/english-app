/* pages/principal/finance/finance.wxss */
page {
  background: #F5F7FA;
}

.finance-page {
  padding: 24rpx;
}

/* 时间选择 */
.time-selector {
  display: flex;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.selector-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666666;
}

.selector-item.active {
  background: #667EEA;
  color: #FFFFFF;
  font-weight: 600;
}

/* 财务概览 */
.finance-overview {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.overview-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.overview-card .card-title {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.overview-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.overview-value.primary {
  color: #667EEA;
}

.overview-value.success {
  color: #52C41A;
}

.overview-change {
  font-size: 22rpx;
}

.overview-change.up {
  color: #52C41A;
}

.overview-change.down {
  color: #FF4D4F;
}

/* 趋势卡片 */
.trend-card,
.expense-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}

.trend-chart {
  margin-top: 16rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
}

.legend-color {
  width: 24rpx;
  height: 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.legend-color.income {
  background: #667EEA;
}

.legend-color.expense {
  background: #FF6B6B;
}

.chart-area {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 48rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.chart-line {
  width: 120rpx;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s;
}

.chart-line.income {
  background: linear-gradient(180deg, #667EEA 0%, rgba(102,126,234,0.3) 100%);
}

.chart-line.expense {
  background: linear-gradient(180deg, #FF6B6B 0%, rgba(255,107,107,0.3) 100%);
}

.chart-labels {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.chart-labels text {
  width: 120rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

/* 支出明细 */
.expense-list {
  margin-top: 16rpx;
}

.expense-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.expense-item:last-child {
  border-bottom: none;
}

.expense-left {
  display: flex;
  align-items: center;
}

.expense-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.expense-info {
  display: flex;
  flex-direction: column;
}

.expense-name {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 4rpx;
}

.expense-desc {
  font-size: 22rpx;
  color: #999999;
}

.expense-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF4D4F;
}

/* 导出按钮 */
.export-section {
  margin-top: 24rpx;
}

.btn-export {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #667EEA;
  border: 2rpx solid #667EEA;
  display: flex;
  align-items: center;
  justify-content: center;
}
