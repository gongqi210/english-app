page {
  background: #F5F7FA;
  padding-bottom: 160rpx;
}

.container {
  padding: 24rpx;
}

/* 搜索 */
.search-bar {
  margin-bottom: 24rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.search-input .icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

/* 统计 */
.stats-row {
  display: flex;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid rgba(255, 255, 255, 0.3);
}

.stat-item:last-child {
  border-right: none;
}

.stat-item .num {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.stat-item .label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 教师列表 */
.teacher-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 12rpx;
}

.role {
  font-size: 22rpx;
  color: #667EEA;
  background: #EDE9FE;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.detail {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.stats {
  display: flex;
  gap: 24rpx;
}

.stat {
  font-size: 22rpx;
  color: #666666;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.btn-action {
  width: 64rpx;
  height: 64rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

/* 添加按钮 */
.btn-add {
  position: fixed;
  bottom: 32rpx;
  left: 32rpx;
  right: 32rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
