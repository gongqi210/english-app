<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <text class="icon">🔍</text>
      <input placeholder="搜索老师..." />
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="num">{{totalCount}}</text>
      <text class="label">教师总数</text>
    </view>
    <view class="stat-item">
      <text class="num">{{activeCount}}</text>
      <text class="label">在职</text>
    </view>
    <view class="stat-item">
      <text class="num">{{classCount}}</text>
      <text class="label">带班数量</text>
    </view>
  </view>

  <!-- 教师列表 -->
  <view class="teacher-list">
    <view class="teacher-card" wx:for="{{teachers}}" wx:key="id">
      <image class="avatar" src="{{item.avatar}}" />
      <view class="info">
        <view class="name-row">
          <text class="name">{{item.name}}</text>
          <text class="role">{{item.role}}</text>
        </view>
        <view class="detail">
          <text>📚 {{item.className}}</text>
          <text>👨‍🎓 {{item.studentCount}}人</text>
        </view>
        <view class="stats">
          <text class="stat">作业: {{item.homeworkCount}}份</text>
          <text class="stat">评分: {{item.rating}}分</text>
        </view>
      </view>
      <view class="actions">
        <button class="btn-action" bindtap="onMessage" data-id="{{item.id}}">💬</button>
        <button class="btn-action" bindtap="onEdit" data-id="{{item.id}}">✏️</button>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <button class="btn-add" bindtap="onAddTeacher">+ 添加老师</button>
</view>
