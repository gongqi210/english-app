/* pages/principal/income/income.wxss */
page {
  background: #F5F7FA;
}

.income-page {
  padding: 24rpx;
}

/* 时间筛选 */
.time-filter {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #666666;
}

.tab.active {
  background: #667EEA;
  color: #FFFFFF;
}

.date-picker {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #333333;
}

.date-picker .arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #999999;
}

/* 概览卡片 */
.overview-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.overview-header {
  margin-bottom: 24rpx;
}

.overview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.overview-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.stat-value.primary {
  color: #667EEA;
}

.stat-change {
  display: inline-block;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.stat-change.up {
  color: #52C41A;
}

.stat-change.down {
  color: #FF4D4F;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #F5F5F5;
}

/* 图表卡片 */
.chart-card,
.composition-card,
.detail-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 趋势图 */
.chart-container {
  height: 300rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 260rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar {
  width: 40rpx;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  border-radius: 8rpx 8rpx 0 0;
  margin-top: auto;
}

.bar-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* 收入构成 */
.composition-list {
  margin-top: 16rpx;
}

.composition-item {
  margin-bottom: 24rpx;
}

.comp-left {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.comp-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.comp-name {
  font-size: 26rpx;
  color: #333333;
}

.comp-right {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comp-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.comp-percent {
  font-size: 24rpx;
  color: #999999;
}

.comp-bar {
  height: 8rpx;
  background: #F5F5F5;
  border-radius: 4rpx;
  overflow: hidden;
}

.comp-fill {
  height: 100%;
  background: linear-gradient(90deg, #667EEA 0%, #764BA2 100%);
  border-radius: 4rpx;
}

/* 收入明细 */
.detail-list {
  margin-top: 16rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-left {
  display: flex;
  align-items: center;
}

.detail-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.detail-info {
  display: flex;
  flex-direction: column;
}

.detail-title {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 4rpx;
}

.detail-desc {
  font-size: 22rpx;
  color: #999999;
}

.detail-right {
  text-align: right;
}

.detail-amount {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #52C41A;
  margin-bottom: 4rpx;
}

.detail-time {
  font-size: 22rpx;
  color: #999999;
}
