page {
  background: #F5F7FA;
  padding-bottom: 140rpx;
}

.container {
  min-height: 100vh;
}

/* 顶部 */
.header {
  position: relative;
  height: 280rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
}

.header-content {
  position: relative;
  padding: 120rpx 32rpx 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.school {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 概览 */
.overview-section {
  padding: 24rpx;
  margin-top: -80rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-card {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #667EEA;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.stat-change {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.stat-change.up {
  color: #7ED321;
}

/* 排名 */
.ranking-section {
  padding: 24rpx;
}

.ranking-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #666666;
  border-radius: 12rpx;
}

.tab.active {
  background: #667EEA;
  color: #FFFFFF;
}

.ranking-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #999999;
  margin-right: 20rpx;
}

.rank-num.top {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  border-radius: 50%;
}

.class-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.class-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.class-teacher {
  font-size: 24rpx;
  color: #999999;
}

.rank-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #667EEA;
}

/* 快捷功能 */
.quick-actions {
  display: flex;
  padding: 24rpx;
  gap: 16rpx;
}

.action-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-label {
  font-size: 24rpx;
  color: #666666;
}

/* 底部导航 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #999999;
}

.tab-item.active {
  color: #667EEA;
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}
