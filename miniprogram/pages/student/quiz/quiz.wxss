/* 星球探险主题 */
page {
  --primary: #6366F1;
  --secondary: #10B981;
  --accent: #F59E0B;
  --bg-dark: #1E1B4B;
  --bg-light: #312E81;
  --success: #22C55E;
  --error: #EF4444;
  --text-primary: #FFFFFF;
  --text-secondary: #A5B4FC;

  background: linear-gradient(180deg, var(--bg-dark) 0%, var(--bg-light) 100%);
  min-height: 100vh;
  color: var(--text-primary);
}

.quiz-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 32rpx 20rpx;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
}

.header-right {
  display: flex;
  align-items: center;
}

.timer {
  font-size: 28rpx;
  color: var(--accent);
  background: rgba(245, 158, 11, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 进度条 */
.progress-bar {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.progress-info {
  margin-bottom: 12rpx;
}

.question-num {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.progress-track {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 题目容器 */
.question-container {
  height: calc(100vh - 400rpx);
  padding: 0 32rpx;
}

.question-card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

/* 音频播放器 - 听力题 */
.audio-player {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
}

.audio-hint {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.audio-wave {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.wave-bar {
  width: 8rpx;
  height: 20rpx;
  background: var(--primary);
  border-radius: 4rpx;
  animation: waveAnimation 0.5s infinite ease-in-out alternate;
}

@keyframes waveAnimation {
  0% { height: 20rpx; }
  100% { height: 60rpx; }
}

.btn-play {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, var(--primary) 0%, #8B5CF6 100%);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  border: none;
}

/* 图片展示 */
.question-image {
  width: 100%;
  height: 300rpx;
  margin-bottom: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.question-image image {
  width: 100%;
  height: 100%;
}

/* 问题文本 */
.question-text {
  font-size: 36rpx;
  line-height: 1.6;
  margin-bottom: 40rpx;
  font-weight: 500;
  text-align: center;
}

/* ========== 选择题 ========== */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.option-item.selected {
  background: rgba(99, 102, 241, 0.2);
  border-color: var(--primary);
}

.option-item.correct {
  background: rgba(34, 197, 94, 0.2);
  border-color: var(--success);
}

.option-item.error {
  background: rgba(239, 68, 68, 0.2);
  border-color: var(--error);
}

.option-key {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-right: 20rpx;
}

.option-item.selected .option-key {
  background: var(--primary);
  color: #FFFFFF;
}

.option-value {
  flex: 1;
  font-size: 30rpx;
}

.option-icon {
  color: var(--primary);
  font-size: 32rpx;
}

/* ========== 听力题 - 图片选择 ========== */
.image-options {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  flex-wrap: wrap;
}

.image-option {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: all 0.3s;
}

.image-option.selected {
  border-color: var(--primary);
  transform: scale(1.05);
}

.image-option image {
  width: 100%;
  height: 100%;
}

.image-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
}

/* ========== 填空题 ========== */
.fill-blank {
  margin-bottom: 24rpx;
}

.fill-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  text-align: center;
}

.input-slots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}

.input-slot {
  min-width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.3);
}

.slot-text {
  font-size: 36rpx;
  font-weight: 600;
}

.slot-input {
  width: 80rpx;
  height: 80rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--accent);
}

/* 键盘 */
.keyboard {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 16rpx;
}

.keyboard-row {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.key {
  width: 56rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  transition: all 0.2s;
}

.key:active {
  background: var(--primary);
  transform: scale(0.95);
}

/* ========== 描红/手写题 ========== */
.tracing-area {
  padding: 24rpx;
}

.tracing-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.tracing-target {
  font-size: 72rpx;
  font-weight: bold;
  color: var(--text-secondary);
}

.tracing-canvas-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.tracing-template {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.template-text {
  font-size: 200rpx;
  font-weight: bold;
}

.writing-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: transparent;
}

.tracing-actions {
  display: flex;
  gap: 16rpx;
}

.btn-clear, .btn-submit-canvas {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-clear {
  background: rgba(255, 255, 255, 0.15);
  color: var(--text-primary);
}

.btn-submit-canvas {
  background: linear-gradient(135deg, var(--primary) 0%, #8B5CF6 100%);
  color: #FFFFFF;
}

/* ========== 跟读题 ========== */
.reading-area {
  text-align: center;
}

.reading-sentence {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--accent);
  margin-bottom: 40rpx;
  padding: 32rpx;
  background: rgba(245, 158, 11, 0.1);
  border-radius: 20rpx;
}

.reference-audio {
  margin-bottom: 40rpx;
}

.btn-listen {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 48rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 48rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  border: none;
}

.record-area {
  margin-bottom: 32rpx;
}

.record-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
  background: linear-gradient(135deg, var(--error) 0%, #DC2626 100%);
  border-radius: 50%;
  transition: all 0.3s;
}

.record-btn.recording {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.record-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.record-text {
  font-size: 24rpx;
}

.wave-animation {
  display: flex;
  gap: 6rpx;
  margin-top: 12rpx;
}

.wave {
  width: 6rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 3rpx;
  animation: wave 0.5s infinite;
}

@keyframes wave {
  0%, 100% { height: 10rpx; }
  50% { height: 30rpx; }
}

.score-result {
  margin-top: 32rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.score-stars {
  margin-bottom: 16rpx;
}

.score-stars .star {
  font-size: 48rpx;
  opacity: 0.3;
}

.score-stars .star.active {
  opacity: 1;
}

.score-text {
  font-size: 28rpx;
  color: var(--accent);
}

/* ========== 连线题 ========== */
.matching-area {
  padding: 24rpx;
}

.matching-container {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.matching-left, .matching-right {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.matching-item {
  width: 240rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

.matching-item.selected {
  background: var(--primary);
}

.matching-line {
  text-align: center;
}

.btn-confirm-match {
  display: inline-flex;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, var(--primary) 0%, #8B5CF6 100%);
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  border: none;
}

/* 解析 */
.explanation {
  margin-top: 32rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
}

.explanation-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.explanation-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 操作栏 */
.action-bar {
  position: fixed;
  bottom: 40rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  gap: 16rpx;
}

.btn-hint, .btn-submit, .btn-next {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-hint {
  flex: 0 0 auto;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.15);
  color: var(--text-primary);
}

.btn-submit {
  flex: 1;
  background: linear-gradient(135deg, var(--primary) 0%, #8B5CF6 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(99, 102, 241, 0.4);
}

.btn-submit.disabled {
  background: rgba(255, 255, 255, 0.2);
  box-shadow: none;
}

.btn-next {
  flex: 1;
  background: linear-gradient(135deg, var(--success) 0%, #10B981 100%);
  color: #FFFFFF;
}

/* 结果弹窗 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
}

.result-modal.show {
  visibility: visible;
}

.result-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.result-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 650rpx;
  background: linear-gradient(180deg, var(--bg-light) 0%, var(--bg-dark) 100%);
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.result-icon {
  font-size: 140rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-top: 16rpx;
}

.result-grade {
  font-size: 80rpx;
  font-weight: bold;
  color: var(--accent);
  margin-top: 24rpx;
}

.result-stars {
  margin: 24rpx 0;
}

.result-stars .star {
  font-size: 48rpx;
  opacity: 0.3;
  margin: 0 4rpx;
}

.result-stars .star.active {
  opacity: 1;
}

.result-stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin: 32rpx 0;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--accent);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.result-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.btn-retry, .btn-finish {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-retry {
  background: rgba(255, 255, 255, 0.15);
  color: var(--text-primary);
}

.btn-finish {
  background: linear-gradient(135deg, var(--success) 0%, #10B981 100%);
  color: #FFFFFF;
}
