/* 星球探险主题色 */
page {
  --primary: #6366F1;
  --secondary: #10B981;
  --accent: #F59E0B;
  --bg-dark: #1E1B4B;
  --bg-light: #312E81;
  --success: #22C55E;
  --error: #EF4444;
  --text-primary: #FFFFFF;
  --text-secondary: #A5B4FC;

  background: linear-gradient(180deg, var(--bg-dark) 0%, var(--bg-light) 100%);
  min-height: 100vh;
  color: var(--text-primary);
}

.container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 顶部导航 */
.header {
  position: relative;
  height: 440rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #EC4899 100%);
}

.stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #FFFFFF;
  border-radius: 50%;
  opacity: 0;
  animation: twinkle 2s infinite;
}

@keyframes twinkle {
  0%, 100% { opacity: 0; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.5); }
}

.header-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 100rpx 32rpx 40rpx;
}

.notification {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notification .icon {
  font-size: 44rpx;
}

.badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--error);
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar image {
  width: 100%;
  height: 100%;
}

/* 今日任务概览 */
.overview-card {
  margin: -120rpx 32rpx 32rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.overview-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.overview-stats {
  display: flex;
  justify-content: center;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--accent);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.stat-divider {
  color: rgba(255, 255, 255, 0.3);
  font-size: 40rpx;
}

/* Tab切换 */
.tab-container {
  padding: 0 32rpx;
}

.tab-list {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--primary) 0%, #8B5CF6 100%);
  color: #FFFFFF;
  font-weight: 600;
}

/* 作业列表 */
.homework-list {
  padding: 24rpx 32rpx;
  height: calc(100vh - 600rpx);
}

.homework-card {
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.card-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #F59E0B 0%, #EF4444 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.card-info {
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.card-deadline, .card-completed {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.card-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.card-status.pending {
  background: rgba(245, 158, 11, 0.2);
  color: var(--accent);
}

.card-status.completed {
  background: rgba(34, 197, 94, 0.2);
  color: var(--success);
}

.card-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 进度条 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: var(--accent);
  min-width: 60rpx;
}

/* 成绩区域 */
.score-section {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  margin-bottom: 24rpx;
}

.score-info, .time-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-label, .time-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.score-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--success);
}

.time-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 操作按钮 */
.card-actions {
  display: flex;
  gap: 16rpx;
}

.btn-primary, .btn-secondary, .btn-outline {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, #8B5CF6 100%);
  color: #FFFFFF;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  color: var(--text-secondary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: var(--text-secondary);
}
