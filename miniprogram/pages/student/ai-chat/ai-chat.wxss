/* pages/student/ai-chat/ai-chat.wxss */

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F8F9FA;
}

.chat-list {
  flex: 1;
  padding: 24rpx;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-content {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  margin: 0 16rpx;
}

.message-item.ai .message-content {
  background: #FFFFFF;
  border-bottom-left-radius: 8rpx;
}

.message-item.user .message-content {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA3E0 100%);
}

.message-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.message-item.user .message-text {
  color: #FFFFFF;
}

.typing {
  padding: 20rpx;
  color: #999999;
  font-size: 24rpx;
}

.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}

.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.message-input {
  flex: 1;
  font-size: 28rpx;
}

.btn-send {
  width: 120rpx;
  height: 64rpx;
  background: #4A90D9;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-send[disabled] {
  background: #CCCCCC;
}

.btn-voice {
  width: 80rpx;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  font-size: 36rpx;
}
