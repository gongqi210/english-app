<!--pages/student/book-read/book-read.wxml-->
<view class="book-read-page">
  <!-- 顶部导航 -->
  <view class="top-bar">
    <view class="back-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="page-indicator">
      <text class="current">{{currentPage}}</text>
      <text class="separator">/</text>
      <text class="total">{{totalPages}}</text>
    </view>
    <view class="speed-btn" bindtap="toggleSpeedMenu">
      <text>🔊 {{playbackSpeed}}x</text>
    </view>
  </view>

  <!-- 绘本内容 -->
  <swiper
    class="content-swiper"
    current="{{currentPage - 1}}"
    bindchange="onPageChange"
    circular="{{false}}"
  >
    <block wx:for="{{pages}}" wx:key="index">
      <swiper-item>
        <scroll-view class="page-content" scroll-y="true">
          <!-- 绘本图片 -->
          <view class="page-image-wrap">
            <image class="page-image" src="{{book.cover}}" mode="aspectFit" />
          </view>

          <!-- 文本内容 -->
          <view class="text-content">
            <view class="sentence" wx:for="{{item.sentences}}" wx:key="index" wx:for-item="sentence">
              <text class="sentence-text {{sentence.phonetic ? 'has-phonetic' : ''}}">{{sentence.text}}</text>
              <text class="phonetic" wx:if="{{sentence.phonetic}}">{{sentence.phonetic}}</text>
            </view>
          </view>
        </scroll-view>
      </swiper-item>
    </block>
  </swiper>

  <!-- 音频控制条 -->
  <view class="audio-control">
    <view class="control-row">
      <view class="control-btn prev" bindtap="prevPage" disabled="{{currentPage <= 1}}">
        <text>⏮</text>
      </view>

      <view class="play-btn" bindtap="togglePlay">
        <text class="play-icon">{{isPlaying ? '⏸' : '▶'}}</text>
      </view>

      <view class="control-btn next" bindtap="nextPage" disabled="{{currentPage >= totalPages}}">
        <text>⏭</text>
      </view>
    </view>

    <view class="progress-row">
      <text class="time-current">{{currentTime}}</text>
      <slider
        class="progress-slider"
        value="{{progress}}"
        max="100"
        activeColor="#4A90D9"
        backgroundColor="#E0E0E0"
        block-size="12"
        bindchange="onSeek"
      />
      <text class="time-total">{{duration}}</text>
    </view>
  </view>

  <!-- 录音按钮 -->
  <view class="record-section">
    <view
      class="record-btn {{isRecording ? 'recording' : ''}}"
      bindtouchstart="startRecord"
      bindtouchend="stopRecord"
    >
      <view class="record-icon">
        <text>🎤</text>
      </view>
      <text class="record-text">{{isRecording ? '松开结束' : '按住录音跟读'}}</text>
      <view class="wave-animation" wx:if="{{isRecording}}">
        <view class="wave wave1"></view>
        <view class="wave wave2"></view>
        <view class="wave wave3"></view>
      </view>
    </view>
  </view>

  <!-- 底部页码导航 -->
  <view class="page-nav">
    <view class="page-list">
      <block wx:for="{{totalPages}}" wx:key="index">
        <view
          class="page-dot {{currentPage === index + 1 ? 'active' : ''}}"
          bindtap="goToPage"
          data-page="{{index + 1}}"
        ></view>
      </block>
    </view>
  </view>

  <!-- 语速选择菜单 -->
  <view class="speed-menu {{showSpeedMenu ? 'show' : ''}}">
    <view class="speed-mask" bindtap="toggleSpeedMenu"></view>
    <view class="speed-list">
      <view
        class="speed-item {{playbackSpeed === 0.5 ? 'active' : ''}}"
        bindtap="setSpeed"
        data-speed="0.5"
      >0.5x 慢速</view>
      <view
        class="speed-item {{playbackSpeed === 0.75 ? 'active' : ''}}"
        bindtap="setSpeed"
        data-speed="0.75"
      >0.75x</view>
      <view
        class="speed-item {{playbackSpeed === 1 ? 'active' : ''}}"
        bindtap="setSpeed"
        data-speed="1"
      >1x 常速</view>
      <view
        class="speed-item {{playbackSpeed === 1.25 ? 'active' : ''}}"
        bindtap="setSpeed"
        data-speed="1.25"
      >1.25x</view>
      <view
        class="speed-item {{playbackSpeed === 1.5 ? 'active' : ''}}"
        bindtap="setSpeed"
        data-speed="1.5"
      >1.5x 快速</view>
    </view>
  </view>
</view>
