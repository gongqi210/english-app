/* pages/student/book-read/book-read.wxss */

.book-read-page {
  min-height: 100vh;
  background: #1A1A2E;
  display: flex;
  flex-direction: column;
}

/* 顶部导航 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: rgba(0, 0, 0, 0.3);
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
}

.page-indicator {
  display: flex;
  align-items: baseline;
  color: #FFFFFF;
}

.current {
  font-size: 40rpx;
  font-weight: bold;
}

.separator {
  font-size: 28rpx;
  margin: 0 8rpx;
  opacity: 0.6;
}

.total {
  font-size: 28rpx;
  opacity: 0.6;
}

.speed-btn {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 26rpx;
}

/* Swiper内容 */
.content-swiper {
  flex: 1;
  height: calc(100vh - 400rpx);
}

.page-content {
  height: 100%;
  padding: 32rpx;
}

.page-image-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.page-image {
  width: 100%;
  max-height: 400rpx;
  border-radius: 16rpx;
}

.text-content {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
}

.sentence {
  margin-bottom: 24rpx;
}

.sentence:last-child {
  margin-bottom: 0;
}

.sentence-text {
  font-size: 36rpx;
  color: #333333;
  line-height: 1.8;
}

.sentence-text.has-phonetic {
  display: inline-block;
  border-bottom: 2rpx solid #FFD700;
}

.phonetic {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 音频控制 */
.audio-control {
  background: rgba(255, 255, 255, 0.95);
  padding: 24rpx 32rpx;
  border-radius: 32rpx 32rpx 0 0;
}

.control-row {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #666666;
}

.control-btn.disabled {
  opacity: 0.3;
}

.play-btn {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.play-icon {
  font-size: 48rpx;
  color: #FFFFFF;
}

.progress-row {
  display: flex;
  align-items: center;
}

.time-current,
.time-total {
  font-size: 24rpx;
  color: #999999;
  width: 80rpx;
}

.progress-slider {
  flex: 1;
  margin: 0 16rpx;
}

/* 录音按钮 */
.record-section {
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.record-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  background: linear-gradient(135deg, #FF69B4 0%, #FF1493 100%);
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}

.record-btn.recording {
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

.record-icon {
  font-size: 56rpx;
}

.record-text {
  font-size: 26rpx;
  color: #FFFFFF;
  margin-top: 8rpx;
}

.wave-animation {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.wave {
  width: 8rpx;
  background: rgba(255, 255, 255, 0.6);
  margin: 0 4rpx;
  border-radius: 4rpx;
  animation: waveAnimation 0.5s ease-in-out infinite;
}

.wave1 { height: 20rpx; animation-delay: 0s; }
.wave2 { height: 40rpx; animation-delay: 0.2s; }
.wave3 { height: 30rpx; animation-delay: 0.4s; }

@keyframes waveAnimation {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(1.5); }
}

/* 页码导航 */
.page-nav {
  padding: 16rpx 32rpx 40rpx;
  background: #FFFFFF;
}

.page-list {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.page-dot {
  width: 16rpx;
  height: 16rpx;
  background: #E0E0E0;
  border-radius: 50%;
  margin: 8rpx;
  transition: all 0.3s;
}

.page-dot.active {
  width: 32rpx;
  background: #4A90D9;
  border-radius: 8rpx;
}

/* 语速菜单 */
.speed-menu {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  visibility: hidden;
}

.speed-menu.show {
  visibility: visible;
}

.speed-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.speed-list {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.speed-menu.show .speed-list {
  transform: translateY(0);
}

.speed-item {
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333333;
  border-radius: 16rpx;
}

.speed-item.active {
  background: rgba(74, 144, 217, 0.15);
  color: #4A90D9;
  font-weight: 600;
}
