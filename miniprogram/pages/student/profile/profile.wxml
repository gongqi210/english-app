<!--pages/student/profile/profile.wxml-->
<view class="profile-page">
  <!-- 头部信息 -->
  <view class="profile-header">
    <view class="avatar-wrap">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
      <view class="level-badge">Lv.{{userInfo.level}}</view>
    </view>
    <view class="user-info">
      <text class="nickname">{{userInfo.nickname}}</text>
      <text class="user-stats">{{userInfo.totalBooks}}本绘本 · {{userInfo.totalReadings}}次跟读</text>
    </view>
    <view class="points-wrap">
      <text class="points">{{userInfo.points}}</text>
      <text class="points-label">积分</text>
    </view>
  </view>

  <!-- 成就徽章 -->
  <view class="section badges-section">
    <view class="section-title">
      <text>🏆 成就徽章</text>
      <text class="more">查看全部 ></text>
    </view>
    <view class="badges-list">
      <block wx:for="{{userInfo.badges}}" wx:key="id">
        <view class="badge-item">
          <view class="badge-icon">{{item.icon}}</view>
          <text class="badge-name">{{item.name}}</text>
          <text class="badge-count">{{item.count}}次</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 学习数据 -->
  <view class="section stats-section">
    <view class="section-title">
      <text>📊 学习数据</text>
    </view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-num">{{userInfo.totalBooks}}</text>
        <text class="stat-label">绘本</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{userInfo.totalReadings}}</text>
        <text class="stat-label">跟读</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{userInfo.totalTime}}</text>
        <text class="stat-label">分钟</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{userInfo.streak}}</text>
        <text class="stat-label">连续天</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="section menu-section">
    <view class="menu-list">
      <view class="menu-item" bindtap="goToReport">
        <text class="menu-icon">📈</text>
        <text class="menu-text">学习报告</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">📚</text>
        <text class="menu-text">我的书架</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">⭐</text>
        <text class="menu-text">收藏绘本</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">📝</text>
        <text class="menu-text">错题本</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="menu-list mt-20">
      <view class="menu-item">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">❓</text>
        <text class="menu-text">帮助与反馈</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="switchRole">
        <text class="menu-icon">👥</text>
        <text class="menu-text">切换角色</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>
