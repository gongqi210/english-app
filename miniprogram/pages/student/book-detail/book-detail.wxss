/* pages/student/book-detail/book-detail.wxss */

.book-detail-page {
  min-height: 100vh;
  background: #F8F9FA;
  padding-bottom: 140rpx;
}

/* 封面区域 */
.cover-section {
  position: relative;
  height: 520rpx;
  overflow: hidden;
}

.cover-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  filter: blur(30rpx);
}

.cover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(74, 144, 217, 0.3) 0%, rgba(74, 144, 217, 0.8) 100%);
}

.cover-content {
  position: relative;
  display: flex;
  padding: 160rpx 32rpx 40rpx;
  z-index: 1;
}

.cover-wrapper {
  flex-shrink: 0;
}

.cover-image {
  width: 220rpx;
  height: 300rpx;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.3);
}

.book-info {
  flex: 1;
  padding-left: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.book-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.book-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.book-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: #FFFFFF;
  margin: -40rpx 32rpx 32rpx;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEEEEE;
}

/* 区块 */
.section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

/* 简介 */
.description {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

.desc-text.collapsed {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.expand-btn {
  display: inline-block;
  font-size: 26rpx;
  color: #4A90D9;
  margin-top: 12rpx;
}

/* 评价 */
.rating-info {
  display: flex;
  align-items: center;
}

.rating-score {
  font-size: 36rpx;
  font-weight: bold;
  color: #F5A623;
  margin-right: 8rpx;
}

.rating-star {
  font-size: 24rpx;
}

.rating-chart {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.rating-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.rating-bar:last-child {
  margin-bottom: 0;
}

.bar-label {
  font-size: 24rpx;
  color: #999999;
  width: 60rpx;
}

.bar-track {
  flex: 1;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #F5A623 0%, #FFD700 100%);
  border-radius: 6rpx;
}

.bar-percent {
  font-size: 24rpx;
  color: #666666;
  width: 60rpx;
  text-align: right;
}

/* 预览 */
.preview-scroll {
  white-space: nowrap;
}

.preview-list {
  display: flex;
}

.preview-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  width: 200rpx;
}

.preview-image {
  width: 180rpx;
  height: 240rpx;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

.preview-page {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.bar-left {
  display: flex;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666666;
  margin-top: 4rpx;
}

.btn-start {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: linear-gradient(135deg, #52C41A 0%, #45a520 100%);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(82, 196, 26, 0.3);
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
