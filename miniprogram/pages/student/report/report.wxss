/* pages/student/report/report.wxss */

.report-page {
  min-height: 100vh;
  background: #F8F9FA;
  padding: 32rpx;
  padding-bottom: 40rpx;
}

/* 头部 */
.report-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.report-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
}

.report-date {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.stat-change {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.stat-change.up {
  background: rgba(82, 196, 26, 0.15);
  color: #52C41A;
}

.stat-divider {
  width: 1rpx;
  height: 100rpx;
  background: #EEEEEE;
}

/* 区块 */
.section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

/* 趋势图 */
.trend-chart {
  padding: 20rpx 0;
}

.chart-canvas {
  height: 300rpx;
}

.chart-bars {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 260rpx;
}

.bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar {
  width: 48rpx;
  background: linear-gradient(180deg, #4A90D9 0%, #6BA3E0 100%);
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
  transition: height 0.5s ease;
}

.bar-score {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  font-weight: 600;
  color: #4A90D9;
}

.bar-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

.trend-summary {
  text-align: center;
  margin-top: 20rpx;
}

.trend-score {
  font-size: 26rpx;
  color: #52C41A;
  background: rgba(82, 196, 26, 0.1);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* 薄弱单词 */
.weak-words-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.weak-word-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
}

.word {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.word-count {
  font-size: 24rpx;
  color: #F5A623;
  margin-right: 16rpx;
}

.btn-practice {
  padding: 8rpx 24rpx;
  background: #4A90D9;
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
}

/* 成就 */
.achievements {
  display: flex;
  justify-content: space-around;
}

.achievement-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.achievement-item.locked {
  opacity: 0.4;
}

.achievement-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.achievement-item.locked .achievement-icon {
  background: #E0E0E0;
}

.achievement-name {
  font-size: 22rpx;
  color: #666666;
  margin-top: 8rpx;
}

/* 目标 */
.goals {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.goal-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: rgba(74, 144, 217, 0.1);
  border-radius: 12rpx;
}

.goal-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.goal-text {
  font-size: 28rpx;
  color: #333333;
}
