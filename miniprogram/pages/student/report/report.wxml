<!--pages/student/report/report.wxml-->
<view class="report-page">
  <!-- 顶部标题 -->
  <view class="report-header">
    <text class="report-title">本周学习总结</text>
    <text class="report-date">2026.3.9 - 3.15</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-icon">📚</text>
      <text class="stat-num">5</text>
      <text class="stat-label">绘本</text>
      <text class="stat-change up">+20%</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-icon">🎯</text>
      <text class="stat-num">12</text>
      <text class="stat-label">跟读</text>
      <text class="stat-change up">+15%</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-icon">⏱️</text>
      <text class="stat-num">3.5h</text>
      <text class="stat-label">时长</text>
      <text class="stat-change up">+30%</text>
    </view>
  </view>

  <!-- 得分趋势 -->
  <view class="section trend-section">
    <view class="section-header">
      <text class="section-title">📈 得分趋势</text>
    </view>
    <view class="trend-chart">
      <view class="chart-canvas">
        <view class="chart-bars">
          <block wx:for="{{weekStats}}" wx:key="index">
            <view class="bar-wrap">
              <view class="bar" style="height: {{item.score * 0.9}}%">
                <text class="bar-score">{{item.score}}</text>
              </view>
              <text class="bar-label">{{item.day}}</text>
            </view>
          </block>
        </view>
      </view>
      <view class="trend-summary">
        <text class="trend-score">进步 +3 分，比上周提升 3.6%</text>
      </view>
    </view>
  </view>

  <!-- 薄弱单词 -->
  <view class="section weak-words-section">
    <view class="section-header">
      <text class="section-title">🔤 需要加强的单词</text>
    </view>
    <view class="weak-words-list">
      <block wx:for="{{weakWords}}" wx:key="index">
        <view class="weak-word-item">
          <text class="word">{{item.word}}</text>
          <text class="word-count">{{item.count}}次错误</text>
          <button class="btn-practice" bindtap="practiceWord" data-word="{{item.word}}">练习</button>
        </view>
      </block>
    </view>
  </view>

  <!-- 获得成就 -->
  <view class="section achievement-section">
    <view class="section-header">
      <text class="section-title">🏆 获得成就</text>
    </view>
    <view class="achievements">
      <view class="achievement-item">
        <view class="achievement-icon">🔥</view>
        <text class="achievement-name">连续学习7天</text>
      </view>
      <view class="achievement-item">
        <view class="achievement-icon">⭐</view>
        <text class="achievement-name">评分95+</text>
      </view>
      <view class="achievement-item locked">
        <view class="achievement-icon">🏅</view>
        <text class="achievement-name">读满30本</text>
      </view>
    </view>
  </view>

  <!-- 下周目标 -->
  <view class="section goal-section">
    <view class="section-header">
      <text class="section-title">🎯 下周目标</text>
    </view>
    <view class="goals">
      <view class="goal-item">
        <text class="goal-icon">📚</text>
        <text class="goal-text">阅读 3 本新绘本</text>
      </view>
      <view class="goal-item">
        <text class="goal-icon">🎯</text>
        <text class="goal-text">跟读 10 次</text>
      </view>
      <view class="goal-item">
        <text class="goal-icon">⭐</text>
        <text class="goal-text">平均分达到 90+</text>
      </view>
    </view>
  </view>
</view>
