/* pages/student/home/home.wxss */

.home-page {
  min-height: 100vh;
  background: #F8F9FA;
  padding-bottom: 120rpx;
}

/* Header */
.header {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA3E0 50%, #87CEEB 100%);
  padding: 120rpx 32rpx 40rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 20rpx;
}

.user-text {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.level {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.streak-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
}

.fire {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.streak-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.streak-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 4rpx;
}

/* Goal Card */
.goal-card {
  background: #FFFFFF;
  margin: -40rpx 32rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 217, 0.15);
}

.goal-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.goal-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.goal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.goal-progress {
  display: flex;
  justify-content: space-between;
}

.progress-item {
  flex: 1;
  text-align: center;
}

.progress-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin: 0 auto 12rpx;
}

.progress-icon.book { background: rgba(74, 144, 217, 0.15); }
.progress-icon.read { background: rgba(82, 196, 26, 0.15); }
.progress-icon.star { background: rgba(250, 173, 20, 0.15); }

.progress-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.progress-label {
  font-size: 22rpx;
  color: #999999;
}

.progress-bar {
  width: 80%;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  margin: 12rpx auto 0;
}

.progress-fill {
  height: 100%;
  background: #4A90D9;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.progress-fill.success { background: #52C41A; }
.progress-fill.warning { background: #F5A623; }

.btn-continue {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  height: 80rpx;
  margin-top: 24rpx;
}

/* 作业入口 */
.homework-entry {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.entry-left {
  display: flex;
  align-items: center;
}

.entry-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.entry-info {
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.entry-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.entry-desc.done {
  color: #7ED321;
}

.entry-right {
  display: flex;
  align-items: center;
}

.entry-action {
  font-size: 26rpx;
  color: #FFFFFF;
}

.entry-action.done {
  color: #7ED321;
}

/* Section */
.section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

/* Recent Books */
.recent-scroll {
  white-space: nowrap;
}

.recent-list {
  display: flex;
}

.recent-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  width: 180rpx;
}

.recent-cover {
  width: 160rpx;
  height: 220rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  position: relative;
}

.recent-progress {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-percent {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.recent-title {
  font-size: 24rpx;
  color: #666666;
  margin-top: 12rpx;
  width: 160rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Book Grid */
.book-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.book-card {
  width: 50%;
  padding: 0 12rpx;
  margin-bottom: 24rpx;
}

.book-cover {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.book-info {
  padding: 12rpx 4rpx;
}

.book-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.book-level {
  font-size: 20rpx;
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.book-rating {
  font-size: 22rpx;
  color: #F5A623;
}

/* Calendar */
.calendar-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.calendar-header {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.calendar-header text {
  font-size: 24rpx;
  color: #999999;
  width: 13%;
  text-align: center;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: 13%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.calendar-day text {
  font-size: 26rpx;
  color: #666666;
}

.calendar-day.checked {
  background: #52C41A;
  border-radius: 50%;
}

.calendar-day.checked text {
  color: #FFFFFF;
}

.calendar-day.today {
  border: 2rpx solid #4A90D9;
  border-radius: 50%;
}

.calendar-day.future text {
  color: #CCCCCC;
}

.streak-info {
  text-align: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.streak-fire {
  font-size: 26rpx;
  color: #666666;
}

.highlight {
  color: #F5A623;
  font-weight: bold;
  font-size: 32rpx;
}

/* FAB AI */
.fab-ai {
  position: fixed;
  bottom: 140rpx;
  right: 32rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FF69B4 0%, #FF1493 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 105, 180, 0.4);
  z-index: 100;
}

.fab-ai text {
  font-size: 44rpx;
}
