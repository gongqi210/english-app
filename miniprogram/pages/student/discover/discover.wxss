/* pages/student/discover/discover.wxss */

.discover-page {
  min-height: 100vh;
  background: #F8F9FA;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.clear-icon {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
}

.filter-btn {
  margin-left: 20rpx;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
}

/* 分类标签 */
.category-scroll {
  background: #FFFFFF;
  padding: 0 32rpx;
}

.category-list {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 0;
}

.category-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  transition: all 0.3s;
}

.category-item.active {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA3E0 100%);
  color: #FFFFFF;
}

/* 排序和难度 */
.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.sort-tabs {
  display: flex;
}

.sort-tab {
  font-size: 26rpx;
  color: #666666;
  margin-right: 32rpx;
  position: relative;
}

.sort-tab.active {
  color: #4A90D9;
  font-weight: 600;
}

.sort-tab.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #4A90D9;
  border-radius: 2rpx;
}

.level-filter {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

/* 绘本列表 */
.book-list-scroll {
  flex: 1;
  padding: 24rpx 32rpx;
}

.book-list {
  display: flex;
  flex-direction: column;
}

.book-item {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.book-cover {
  width: 180rpx;
  height: 240rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.book-content {
  flex: 1;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.book-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.book-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.book-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.book-tag {
  font-size: 20rpx;
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.book-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.meta-left {
  display: flex;
  align-items: center;
}

.level-badge {
  font-size: 22rpx;
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.age-range {
  font-size: 22rpx;
  color: #999999;
}

.rating {
  font-size: 24rpx;
  color: #F5A623;
}

.book-action {
  display: flex;
  align-items: flex-end;
}

.start-btn {
  width: 80rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #52C41A 0%, #45a520 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: #999999;
  font-size: 24rpx;
}

.loading-icon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E0E0E0;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 筛选弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
}

.filter-modal.show {
  visibility: visible;
}

.filter-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.filter-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  max-height: 70vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.filter-modal.show .filter-content {
  transform: translateY(0);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.filter-close {
  font-size: 36rpx;
  color: #999999;
  padding: 8rpx;
}

.filter-section {
  margin-bottom: 32rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  padding: 16rpx 32rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666666;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.filter-option.active {
  background: linear-gradient(135deg, #4A90D9 0%, #6BA3E0 100%);
  color: #FFFFFF;
}

.filter-buttons {
  display: flex;
  margin-top: 32rpx;
}

.btn-reset {
  flex: 1;
  height: 88rpx;
  background: #F5F5F5;
  color: #666666;
  border-radius: 44rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.btn-confirm {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 28rpx;
}
