page {
  background: var(--teacher-bg, #F0FDFA);
  min-height: 100vh;
}

.homework-create-page {
  min-height: 100vh;
  background: var(--teacher-bg, #F0FDFA);
  padding-bottom: 160rpx;
}

/* 自定义导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  text-align: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
}

/* 步骤指示器 */
.step-section {
  position: relative;
  z-index: 50;
  background: #FFFFFF;
  padding: 32rpx 32rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 184, 166, 0.08);
}

.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E5E5E5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.step-item.active .step-circle {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
  box-shadow: 0 4rpx 16rpx rgba(20, 184, 166, 0.4);
}

.step-item.completed .step-circle {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
}

.step-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.step-check {
  font-size: 28rpx;
  color: #FFFFFF;
}

.step-label {
  font-size: 22rpx;
  color: #999999;
  transition: color 0.3s ease;
}

.step-item.active .step-label {
  color: var(--teacher-primary, #14B8A6);
  font-weight: 600;
}

.step-line {
  width: 80rpx;
  height: 4rpx;
  background: #E5E5E5;
  margin: 0 16rpx 32rpx;
  border-radius: 2rpx;
  transition: background 0.3s ease;
}

.step-line.active {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
}

/* 表单内容 */
.form-content {
  padding: 24rpx 32rpx;
}

.step-panel {
  display: none;
}

.step-panel.active {
  display: block;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.form-section {
  background: #FFFFFF;
  border-radius: var(--radius-lg, 24rpx);
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 184, 166, 0.08);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-child, 40rpx);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333333;
}

.picker-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-child, 40rpx);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333333;
}

.arrow {
  color: var(--teacher-primary, #14B8A6);
  font-size: 24rpx;
}

/* 绘本列表 */
.book-list {
  white-space: nowrap;
}

.book-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 180rpx;
  margin-right: 20rpx;
  position: relative;
}

.book-cover {
  width: 160rpx;
  height: 200rpx;
  border-radius: var(--radius-lg, 24rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 12rpx;
}

.book-title {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 160rpx;
}

.book-card.selected .book-cover {
  border: 4rpx solid var(--teacher-primary, #14B8A6);
}

.book-check {
  position: absolute;
  top: 8rpx;
  right: 20rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--teacher-primary, #14B8A6);
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 题目类型 */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  width: calc(50% - 8rpx);
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-lg, 24rpx);
  border: 2rpx solid transparent;
  position: relative;
  transition: all 0.2s ease;
}

.type-item.selected {
  border-color: var(--teacher-primary, #14B8A6);
  background: #FFFFFF;
}

.type-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.type-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.type-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--teacher-primary, #14B8A6);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 数量控制 */
.count-section {
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-lg, 24rpx);
  padding: 20rpx;
}

.count-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E5E5E5;
}

.count-item:last-child {
  border-bottom: none;
}

.count-label {
  font-size: 28rpx;
  color: #333333;
}

.count-control {
  display: flex;
  align-items: center;
}

.count-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--teacher-primary, #14B8A6);
  box-shadow: 0 2rpx 8rpx rgba(20, 184, 166, 0.2);
}

.count-btn:active {
  transform: scale(0.95);
}

.count-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  min-width: 60rpx;
  text-align: center;
}

/* 题目预览列表 */
.preview-list {
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-lg, 24rpx);
  padding: 20rpx;
}

.preview-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E5E5E5;
}

.preview-item:last-of-type {
  border-bottom: none;
}

.preview-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--teacher-primary, #14B8A6);
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.preview-content {
  flex: 1;
}

.preview-type {
  display: block;
  font-size: 22rpx;
  color: var(--teacher-primary, #14B8A6);
  margin-bottom: 4rpx;
}

.preview-text {
  display: block;
  font-size: 26rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-remove {
  font-size: 28rpx;
  color: #EF4444;
  padding: 8rpx;
  margin-left: 12rpx;
}

.add-questions-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 2rpx dashed var(--teacher-primary, #14B8A6);
  border-radius: var(--radius-lg, 24rpx);
  margin-top: 16rpx;
}

.add-icon {
  font-size: 32rpx;
  color: var(--teacher-primary, #14B8A6);
  margin-right: 12rpx;
}

.add-text {
  font-size: 26rpx;
  color: var(--teacher-primary, #14B8A6);
}

/* 设置区域 */
.settings-section {
  padding: 0;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-title {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.setting-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

/* 预览区域 */
.preview-section {
  padding: 0;
}

.preview-header {
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.preview-card {
  padding: 24rpx 32rpx 32rpx;
}

.preview-book {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.preview-cover {
  width: 100rpx;
  height: 130rpx;
  border-radius: var(--radius-lg, 24rpx);
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.preview-book-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.preview-book-author {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.preview-divider {
  height: 1rpx;
  background: #F0F0F0;
  margin-bottom: 24rpx;
}

.preview-info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.preview-info-item {
  width: calc(50% - 12rpx);
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.preview-settings {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preview-setting-tag {
  padding: 10rpx 20rpx;
  background: #F0F0F0;
  border-radius: var(--radius-child, 40rpx);
  font-size: 22rpx;
  color: #999999;
}

.preview-setting-tag.active {
  background: var(--teacher-bg, #F0FDFA);
  color: var(--teacher-primary, #14B8A6);
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(20, 184, 166, 0.1);
}

.btn-prev,
.btn-next,
.btn-draft,
.btn-publish {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-child, 40rpx);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-prev {
  background: #F0F0F0;
  color: #666666;
}

.btn-prev.disabled {
  opacity: 0.5;
}

.btn-next {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(20, 184, 166, 0.3);
}

.btn-draft {
  background: #F0F0F0;
  color: #666666;
}

.btn-publish {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(20, 184, 166, 0.3);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
}