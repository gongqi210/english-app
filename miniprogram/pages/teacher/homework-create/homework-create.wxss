page {
  background: #F5F7FA;
  padding-bottom: 200rpx;
}

.container {
  padding: 24rpx;
}

/* 表单区域 */
.form-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.picker-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.arrow {
  color: #999999;
  font-size: 24rpx;
}

/* 题目选择 */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.btn-add-question {
  padding: 12rpx 24rpx;
  background: #4A90D9;
  border-radius: 20rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}

/* 题目列表 */
.questions-container {
  margin-bottom: 24rpx;
}

.question-block {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.block-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.block-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A90D9;
  margin-right: 16rpx;
}

.block-type {
  flex: 1;
  font-size: 24rpx;
  color: #999999;
}

.block-delete {
  color: #FF4D4F;
  font-size: 32rpx;
}

.block-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.drag-handle {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

.empty-questions {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  color: #999999;
}

/* 设置 */
.settings-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item text {
  font-size: 28rpx;
  color: #333333;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn-draft, .btn-publish {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-draft {
  background: #F5F7FA;
  color: #666666;
}

.btn-publish {
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  color: #FFFFFF;
}
