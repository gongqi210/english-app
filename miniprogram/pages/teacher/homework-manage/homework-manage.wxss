page {
  background: var(--teacher-bg, #F0FDFA);
  min-height: 100vh;
}

.homework-manage-page {
  min-height: 100vh;
  background: var(--teacher-bg, #F0FDFA);
  padding-bottom: 40rpx;
}

/* 自定义导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  text-align: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
}

/* 统计卡片 */
.stats-section {
  position: relative;
  z-index: 50;
  padding: 24rpx 32rpx 0;
}

.stats-card {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
  border-radius: var(--radius-lg, 24rpx);
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(20, 184, 166, 0.3);
}

.stats-grid {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 筛选区域 */
.filter-section {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 20rpx;
}

.filter-tabs {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #FFFFFF;
  border-radius: var(--radius-child, 40rpx);
  font-size: 26rpx;
  color: #666666;
  transition: all 0.2s ease;
}

.tab.active {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(20, 184, 166, 0.3);
}

.class-filter {
  flex-shrink: 0;
}

.class-picker {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-child, 40rpx);
  font-size: 24rpx;
  color: #333333;
  box-shadow: 0 4rpx 16rpx rgba(20, 184, 166, 0.1);
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--teacher-primary, #14B8A6);
  margin-left: 12rpx;
}

/* 作业列表 */
.homework-list {
  height: calc(100vh - 380rpx);
  padding: 0 32rpx;
}

.homework-card {
  background: #FFFFFF;
  border-radius: var(--radius-lg, 24rpx);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 184, 166, 0.08);
}

.card-header {
  margin-bottom: 20rpx;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  margin-right: 16rpx;
}

.status-pill {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-child, 40rpx);
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-pill.ongoing {
  background: var(--teacher-bg, #F0FDFA);
  color: var(--teacher-primary, #14B8A6);
}

.status-pill.finished {
  background: #F0F0F0;
  color: #999999;
}

.status-pill.pending {
  background: #FEF3C7;
  color: #D97706;
}

.card-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.meta-dot {
  margin: 0 8rpx;
}

/* 进度条 */
.progress-section {
  margin-bottom: 20rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #666666;
}

.progress-value {
  font-size: 24rpx;
  color: var(--teacher-primary, #14B8A6);
  font-weight: 600;
}

.progress-bar {
  height: 12rpx;
  background: var(--teacher-bg, #F0FDFA);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-light, #5EEAD4) 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 分数区域 */
.score-section {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-top: 1rpx solid #F0F0F0;
  border-bottom: 1rpx solid #F0F0F0;
}

.score-item {
  display: flex;
  align-items: center;
}

.score-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-child, 40rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.score-icon.avg {
  background: var(--teacher-bg, #F0FDFA);
}

.score-icon.excellent {
  background: #FEF3C7;
}

.score-icon.warning {
  background: #FEE2E2;
}

.score-icon-text {
  font-size: 28rpx;
}

.score-info {
  display: flex;
  flex-direction: column;
}

.score-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 2rpx;
}

.score-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.score-value.good {
  color: #22C55E;
}

.score-value.warn {
  color: #EF4444;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  justify-content: space-between;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-child, 40rpx);
  margin-right: 12rpx;
}

.action-btn:last-child {
  margin-right: 0;
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
}

.action-btn.primary .action-text {
  color: #FFFFFF;
}

.action-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--teacher-primary, #14B8A6);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.empty-action {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
  border-radius: var(--radius-child, 40rpx);
  box-shadow: 0 4rpx 16rpx rgba(20, 184, 166, 0.3);
}

.empty-btn {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 反馈弹窗 */
.feedback-modal, .preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.feedback-modal.show, .preview-modal.show {
  visibility: visible;
  opacity: 1;
}

.feedback-mask, .preview-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.feedback-content, .preview-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  max-height: 90vh;
  overflow-y: auto;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.feedback-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.close-btn {
  font-size: 40rpx;
  color: #999999;
  padding: 8rpx;
}

.feedback-section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ai-tip, .edit-tip {
  font-size: 22rpx;
  color: #999999;
  font-weight: normal;
}

/* 学生列表 */
.student-list {
  white-space: nowrap;
  height: 140rpx;
}

.student-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  padding: 16rpx;
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-lg, 24rpx);
  border: 2rpx solid transparent;
  min-width: 120rpx;
}

.student-item.selected {
  border-color: var(--teacher-primary, #14B8A6);
  background: #FFFFFF;
}

.student-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.student-name {
  font-size: 22rpx;
  color: #333333;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-score {
  font-size: 20rpx;
  color: var(--teacher-primary, #14B8A6);
}

/* AI反馈 */
.ai-feedback {
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-lg, 24rpx);
  padding: 20rpx;
}

.feedback-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: #FFFFFF;
  border-radius: var(--radius-lg, 24rpx);
  padding: 20rpx;
}

.ai-actions {
  margin-top: 16rpx;
}

.btn-regenerate {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-child, 40rpx);
  font-size: 24rpx;
  color: var(--teacher-primary, #14B8A6);
  border: 1rpx solid var(--teacher-primary, #14B8A6);
}

/* 老师编辑 */
.teacher-feedback {
  width: 100%;
  height: 200rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--teacher-primary, #14B8A6);
  border-radius: var(--radius-lg, 24rpx);
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 发送选项 */
.send-options {
  display: flex;
  gap: 24rpx;
}

.send-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-lg, 24rpx);
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.send-option.checked {
  border-color: var(--teacher-primary, #14B8A6);
  background: #FFFFFF;
}

.check-icon {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #DDDDDD;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--teacher-primary, #14B8A6);
}

.send-option.checked .check-icon {
  border-color: var(--teacher-primary, #14B8A6);
  background: var(--teacher-primary, #14B8A6);
  color: #FFFFFF;
}

/* 发送按钮 */
.feedback-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.btn-preview, .btn-send {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-child, 40rpx);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-preview {
  background: var(--teacher-bg, #F0FDFA);
  color: #666666;
}

.btn-send {
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(20, 184, 166, 0.3);
}

/* 预览弹窗 */
.preview-content {
  top: 50%;
  transform: translateY(-50%) scale(0.9);
  max-height: 60vh;
  border-radius: var(--radius-lg, 24rpx);
  opacity: 0;
  transition: all 0.3s ease;
}

.preview-modal.show .preview-content {
  transform: translateY(-50%) scale(1);
  opacity: 1;
}

.preview-header {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.preview-chat {
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-lg, 24rpx);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.preview-msg {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.msg-time {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.msg-bubble {
  max-width: 80%;
  background: linear-gradient(135deg, var(--teacher-primary, #14B8A6) 0%, var(--teacher-primary-dark, #0D9488) 100%);
  border-radius: var(--radius-lg, 24rpx);
  padding: 20rpx;
}

.msg-text {
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 1.5;
}

.btn-close-preview {
  width: 100%;
  height: 88rpx;
  background: var(--teacher-bg, #F0FDFA);
  border-radius: var(--radius-child, 40rpx);
  font-size: 28rpx;
  color: #666666;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}