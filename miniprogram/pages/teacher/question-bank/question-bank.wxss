page {
  background: #F5F7FA;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 24rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

/* 筛选标签 */
.filter-tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.tab {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666666;
}

.tab.active {
  background: #4A90D9;
  color: #FFFFFF;
}

/* 题目列表头部 */
.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.btn-add {
  padding: 16rpx 32rpx;
  background: #4A90D9;
  border-radius: 20rpx;
  color: #FFFFFF;
  font-size: 26rpx;
}

/* 题目列表 */
.question-list {
  height: calc(100vh - 600rpx);
}

.question-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.type-tag {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #FFFFFF;
}

.type-tag.choice { background: #4A90D9; }
.type-tag.fill_blank { background: #7ED321; }
.type-tag.listening { background: #F5A623; }
.type-tag.tracing { background: #9B59B6; }
.type-tag.reading { background: #E91E63; }

.card-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #4A90D9;
}

.action-btn.delete {
  color: #FF4D4F;
}

.question-content {
  margin-bottom: 16rpx;
}

.question-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.question-options {
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.option {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.opt-key {
  color: #666666;
  margin-right: 8rpx;
}

.opt-value {
  color: #333333;
}

.question-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEEEEE;
}

.meta-item {
  display: flex;
  font-size: 24rpx;
}

.meta-item .label {
  color: #999999;
}

.meta-item .value {
  color: #666666;
}

/* 导入区域 */
.import-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.import-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.import-options {
  display: flex;
  justify-content: space-around;
}

.import-option {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.import-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.import-label {
  font-size: 24rpx;
  color: #666666;
}
