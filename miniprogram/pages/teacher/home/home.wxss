/* pages/teacher/home/home.wxss */

.teacher-page {
  min-height: 100vh;
  background: #F8F9FA;
}

.header {
  background: linear-gradient(135deg, #52C41A 0%, #45a520 100%);
  padding: 120rpx 32rpx 60rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.info {
  padding-left: 20rpx;
}

.name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.role {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.stats-section {
  display: flex;
  background: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #52C41A;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.menu-section {
  background: #FFFFFF;
  margin: 0 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
}

.menu-badge {
  background: #FF4D4F;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-right: 10rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-right {
  margin-left: auto;
}

.current-time {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(0, 0, 0, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.stats-section {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  padding: 24rpx 16rpx;
  margin: -40rpx 32rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.stat-card {
  flex: 1;
  min-width: 25%;
  text-align: center;
  padding: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.refresh-link,
.more-link {
  font-size: 24rpx;
  color: #52C41A;
}

.todo-section {
  background: #FFFFFF;
  margin: 0 32rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.todo-list {
  padding: 0 24rpx 24rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.todo-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.todo-icon.homework {
  background: rgba(82, 196, 26, 0.15);
}

.todo-icon.review {
  background: rgba(255, 148, 6, 0.15);
}

.todo-icon.upload {
  background: rgba(24, 144, 255, 0.15);
}

.todo-content {
  flex: 1;
}

.todo-title {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.todo-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.todo-action {
  margin-left: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #52C41A;
  padding: 8rpx 20rpx;
  border: 1rpx solid #52C41A;
  border-radius: 20rpx;
}

.recent-section {
  background: #FFFFFF;
  margin: 0 32rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.homework-list {
  padding: 0 24rpx 24rpx;
}

.homework-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.homework-info {
  flex: 1;
}

.homework-title {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.homework-class {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.homework-stats {
  display: flex;
}

.homework-stats .stat-item {
  text-align: center;
  margin-left: 24rpx;
}

.homework-stats .stat-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.homework-stats .stat-value {
  display: block;
  font-size: 28rpx;
  color: #52C41A;
  font-weight: 600;
}
