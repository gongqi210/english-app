page {
  --payment-success: #10B981;
  --payment-success-light: rgba(16, 185, 129, 0.1);
  --payment-failed: #EF4444;
  --payment-failed-light: rgba(239, 68, 68, 0.1);
  --principal-primary: #6366F1;
  --principal-primary-dark: #4F46E5;
  --bg-card: #FFFFFF;
  --radius-lg: 24rpx;
  --radius-child: 40rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);

  background: linear-gradient(180deg, #FFFFFF 0%, #F9FAFB 100%);
  min-height: 100vh;
}

.result-page {
  padding: 24rpx 48rpx 48rpx;
  text-align: center;
}

/* Custom Navigation */
.custom-nav {
  background: linear-gradient(135deg, var(--principal-primary, #6366F1) 0%, var(--principal-primary-dark, #4F46E5) 100%);
  padding: 60rpx 32rpx 32rpx;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
  text-align: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
}

/* Result Icon */
.result-icon-container {
  margin-bottom: 48rpx;
}

.result-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bounce-in 0.6s var(--ease-bounce);
}

.result-icon.success {
  background: var(--payment-success-light);
}

.result-icon.failed {
  background: var(--payment-failed-light);
}

.result-icon text {
  font-size: 80rpx;
}

.result-icon.success text {
  color: var(--payment-success);
}

.result-icon.failed text {
  color: var(--payment-failed);
}

@keyframes bounce-in {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  50% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* Result Title */
.result-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 48rpx;
}

/* Order Card */
.order-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.order-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: #1F2937;
}

.order-body {
  padding: 8rpx 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6B7280;
}

.info-value {
  font-size: 26rpx;
  color: #1F2937;
}

.info-value.price {
  font-weight: 600;
  color: var(--payment-success);
}

/* Actions */
.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary,
.btn-secondary,
.btn-outline {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--principal-primary) 0%, var(--principal-primary-dark) 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.3);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--principal-primary);
  color: #FFFFFF;
}

.btn-secondary:active {
  transform: scale(0.98);
}

.btn-outline {
  background: var(--bg-card);
  color: #6B7280;
  border: 2rpx solid #E5E7EB;
}

.btn-outline:active {
  transform: scale(0.98);
  background: #F9FAFB;
}