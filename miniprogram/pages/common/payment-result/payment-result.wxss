/* pages/common/payment-result/payment-result.wxss */
page {
  background: #F5F7FA;
}

.result-page {
  padding: 80rpx 48rpx;
  text-align: center;
}

.result-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin: 0 auto 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.result-icon.success {
  background: rgba(82, 196, 26, 0.15);
  color: #52C41A;
}

.result-icon.failed {
  background: rgba(255, 77, 79, 0.15);
  color: #FF4D4F;
}

.result-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 48rpx;
}

.order-info {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 48rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .label {
  font-size: 26rpx;
  color: #999999;
}

.info-row .value {
  font-size: 26rpx;
  color: #333333;
}

.info-row .value.price {
  color: #FF6B6B;
  font-weight: 600;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary,
.btn-secondary,
.btn-outline {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  border: none;
}

.btn-secondary {
  background: #667EEA;
  color: #FFFFFF;
  border: none;
}

.btn-outline {
  background: #FFFFFF;
  color: #666666;
  border: 1rpx solid #E5E5E5;
}
