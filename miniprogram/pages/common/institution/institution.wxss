page {
  background: #F5F7FA;
  padding-bottom: 200rpx;
}

.container {
  padding: 24rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

/* Logo上传 */
.logo-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #DDDDDD;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.logo-preview {
  width: 180rpx;
  height: 180rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999999;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999999;
}

/* 颜色选择 */
.color-picker {
  display: flex;
  gap: 16rpx;
}

.color-option {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.color-option.selected {
  border-color: #333333;
}

.custom-color {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.color-input {
  flex: 1;
  height: 80rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.color-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
}

/* 预览 */
.preview-card {
  border: 2rpx solid #EEEEEE;
  border-radius: 24rpx;
  overflow: hidden;
}

.preview-header {
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-logo {
  width: 60rpx;
  height: 60rpx;
}

.preview-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.preview-body {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-btn {
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.preview-btn:first-child {
  background: #F5F7FA;
  color: #666666;
}

/* 保存按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn-save {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #3A7BC8 100%);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
