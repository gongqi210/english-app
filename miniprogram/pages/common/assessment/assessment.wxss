page {
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部 */
.header {
  display: flex;
  align-items: center;
  padding: 100rpx 32rpx 32rpx;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #FFFFFF;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  padding-right: 80rpx;
}

/* 进度 */
.progress-section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.progress-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: #7ED321;
  border-radius: 8rpx;
}

.progress-text {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 题目卡片 */
.question-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  margin: 0 32rpx 32rpx;
}

.question-image {
  width: 100%;
  height: 300rpx;
  margin-bottom: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.question-image image {
  width: 100%;
  height: 100%;
}

.question-text {
  font-size: 34rpx;
  text-align: center;
  color: #333333;
  margin-bottom: 40rpx;
}

/* 口语 */
.speaking-section {
  text-align: center;
}

.sentence-to-say {
  font-size: 36rpx;
  color: #4A90D9;
  padding: 32rpx;
  background: #F0F7FF;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}

.record-area {
  margin-bottom: 32rpx;
}

.record-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 50%;
  color: #FFFFFF;
}

.record-btn .icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.record-btn.recording {
  animation: pulse 1s infinite;
}

/* 选择题 */
.options {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  justify-content: center;
}

.option {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: all 0.3s;
}

.option.selected {
  border-color: #667EEA;
  transform: scale(1.05);
}

.option image {
  width: 100%;
  height: 100%;
}

.option text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F7FA;
  font-size: 32rpx;
}

/* 操作按钮 */
.actions {
  padding: 0 32rpx;
}

.btn-next {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

/* 报告 */
.report-content {
  padding: 0 32rpx;
}

.report-header {
  text-align: center;
  color: #FFFFFF;
  margin-bottom: 32rpx;
}

.congrats {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.level {
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.level-desc {
  font-size: 28rpx;
  opacity: 0.8;
}

/* 雷达图/能力条 */
.radar-section, .detail-section, .recommend-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.radar-title, .detail-title, .recommend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.radar-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.radar-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #666666;
}

.radar-bar {
  flex: 1;
  height: 24rpx;
  background: #F0F0F0;
  border-radius: 12rpx;
  margin: 0 16rpx;
}

.radar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667EEA 0%, #764BA2 100%);
  border-radius: 12rpx;
}

.radar-score {
  width: 80rpx;
  font-size: 24rpx;
  color: #667EEA;
  font-weight: 600;
}

/* 评估详情 */
.detail-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.detail-score {
  font-size: 28rpx;
  color: #667EEA;
  font-weight: 600;
  margin-left: 16rpx;
}

.detail-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 推荐 */
.recommend-item {
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
}

/* 报告按钮 */
.report-actions {
  display: flex;
  gap: 24rpx;
}

.btn-download, .btn-confirm {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-download {
  background: #FFFFFF;
  color: #667EEA;
}

.btn-confirm {
  background: #7ED321;
  color: #FFFFFF;
}
