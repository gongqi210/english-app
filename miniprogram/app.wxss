/* 全局样式 - 我AI学英语 */

/* CSS变量 */
page {
  --primary: #4A90D9;
  --primary-light: #6BA3E0;
  --primary-dark: #3A7BC8;
  --secondary: #7ED321;
  --accent: #F5A623;
  --success: #52C41A;
  --warning: #FAAD14;
  --error: #FF4D4F;
  --info: #1890FF;

  --bg-page: #F8F9FA;
  --bg-card: #FFFFFF;
  --bg-mask: rgba(0, 0, 0, 0.5);

  --text-primary: #333333;
  --text-secondary: #666666;
  --text-disabled: #999999;
  --text-placeholder: #CCCCCC;

  --border-color: #EEEEEE;
  --border-light: #F5F5F5;

  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.10);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;

  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 40rpx;

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.6;
}

/* 重置样式 */
view, text, image, button, input, textarea, scroll-view, swiper, picker {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: inherit;
}

button::after {
  border: none;
}

/* 常用工具类 */
.container {
  min-height: 100vh;
  padding: var(--spacing-md);
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-primary {
  color: var(--primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-disabled {
  color: var(--text-disabled);
}

.text-success {
  color: var(--success);
}

.text-warning {
  color: var(--warning);
}

.text-error {
  color: var(--error);
}

.text-sm {
  font-size: var(--font-sm);
}

.text-lg {
  font-size: var(--font-lg);
}

.text-xl {
  font-size: var(--font-xl);
}

.text-bold {
  font-weight: bold;
}

.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }

.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }

.ml-xs { margin-left: var(--spacing-xs); }
.ml-sm { margin-left: var(--spacing-sm); }
.ml-md { margin-left: var(--spacing-md); }

.mr-xs { margin-right: var(--spacing-xs); }
.mr-sm { margin-right: var(--spacing-sm); }
.mr-md { margin-right: var(--spacing-md); }

.p-xs { padding: var(--spacing-xs); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: var(--spacing-md);
}

.card-title {
  font-size: var(--font-lg);
  font-weight: bold;
  margin-bottom: var(--spacing-sm);
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 var(--spacing-lg);
  border-radius: var(--radius-lg);
  font-size: var(--font-md);
  font-weight: 500;
  transition: all 0.2s ease;
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #FFFFFF;
}

.btn-secondary {
  background: #FFFFFF;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-success {
  background: linear-gradient(135deg, var(--success) 0%, #45a520 100%);
  color: #FFFFFF;
}

.btn-warning {
  background: linear-gradient(135deg, var(--warning) 0%, #e6990f 100%);
  color: #FFFFFF;
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 64rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-sm);
}

.btn-lg {
  height: 100rpx;
  font-size: var(--font-lg);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: 500;
}

.tag-primary {
  background: rgba(74, 144, 217, 0.15);
  color: var(--primary);
}

.tag-success {
  background: rgba(82, 196, 26, 0.15);
  color: var(--success);
}

.tag-warning {
  background: rgba(250, 173, 20, 0.15);
  color: var(--warning);
}

.tag-error {
  background: rgba(255, 77, 79, 0.15);
  color: var(--error);
}

.tag-outline {
  background: transparent;
  border: 1rpx solid var(--border-color);
}

/* 头像 */
.avatar {
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-page);
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
}

.avatar-md {
  width: 96rpx;
  height: 96rpx;
}

.avatar-lg {
  width: 128rpx;
  height: 128rpx;
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-full);
  background: var(--error);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-md);
}

.empty-text {
  color: var(--text-secondary);
  font-size: var(--font-md);
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: var(--spacing-md) 0;
}

/* 渐变背景 */
.gradient-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
}

.gradient-success {
  background: linear-gradient(135deg, var(--success) 0%, #45a520 100%);
}

.gradient-warning {
  background: linear-gradient(135deg, var(--warning) 0%, #e6990f 100%);
}

.gradient-pink {
  background: linear-gradient(135deg, #FFB6C1 0%, #FF69B4 100%);
}

.gradient-purple {
  background: linear-gradient(135deg, #DDA0DD 0%, #9370DB 100%);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent) 0%, #e6990f 100%);
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 40rpx;
  z-index: 100;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}
